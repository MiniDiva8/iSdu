.route-page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
  padding: 50rpx;
  background: #f7f5ec;
  color: #4c6b58;
  font-size: 28rpx;
}
.route-page button {
  background: #e5ebd9;
  border-radius: 40rpx;
  padding: 15rpx 45rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #456548;
}
