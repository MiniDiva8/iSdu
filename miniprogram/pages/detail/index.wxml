<view class="journal-detail">
  <view wx:if="{{isLoading}}" class="detail-wait">正在翻开这页日记…</view>
  <view wx:elif="{{loadError}}" class="detail-wait"
    ><text class="detail-wait__title">{{loadErrorTitle}}</text><text>{{loadError}}</text
    ><button wx:if="{{memoryId && memory}}" bindtap="loadMemory">重新读取</button
    ><button bindtap="returnToMap">回校园看看</button></view
  >
  <block wx:elif="{{memory}}">
    <view class="detail-caption"
      ><text>{{isFriendMemory ? ownerDisplayName + ' 愿意分享的日记' : '写给以后的自己'}}</text
      ><text wx:if="{{memory.origin === 'demo'}}">示例日记</text></view
    >
    <view class="detail-paper">
      <view class="detail-paper__head"
        ><text>{{formattedRecordedAt}}</text><text>校园日记</text></view
      >
      <view class="detail-mood"
        ><mood-face mood="{{memory.mood}}" size="large" /><text>{{moodLabel}}</text></view
      >
      <text wx:if="{{hasText}}" class="detail-writing" selectable>{{memory.text}}</text
      ><text wx:else class="detail-writing detail-writing--empty">把这一天，留在照片里。</text>
      <view wx:if="{{photoItems.length}}" class="detail-photos"
        ><view wx:for="{{photoItems}}" wx:key="path" class="detail-photo"
          ><view class="detail-photo__tape"></view
          ><image
            wx:if="{{!item.isMissing}}"
            src="{{item.path}}"
            mode="widthFix"
            data-index="{{index}}"
            binderror="handleImageError"
            bindtap="previewPhoto"
          /><view wx:else class="detail-photo__missing">这张照片暂时无法显示</view></view
        ></view
      >
      <view class="detail-paper__end"
        ><text>{{categoryLabel}}</text><text>{{displayPlaceName}}</text></view
      >
    </view>
    <view wx:if="{{hasLocation}}" class="detail-location"
      ><view
        ><t-icon name="location" size="20px" /><text
          >{{memory.placeName || '校园里的这个地方'}}</text
        ></view
      ><view class="detail-map" bindtap="showOnMap"
        ><image src="{{mapPreviewSource}}" mode="scaleToFill" lazy-load /><view
          class="detail-map__pin"
          style="left:{{mapPreviewMarkerX}};top:{{mapPreviewMarkerY}}"
        ></view></view
      ><button bindtap="showOnMap">
        回到故事发生的地方 <t-icon name="chevron-right" size="17px" /></button
    ></view>
    <view wx:else class="detail-no-location"
      ><t-icon name="leaf" size="19px" /><text>这一页，只收藏心情与生活。</text></view
    >
    <view wx:if="{{actionMessage}}" class="detail-message">{{actionMessage}}</view>
    <view wx:if="{{isFriendMemory}}" class="detail-friend"
      ><button
        class="{{likedByMe ? 'is-liked' : ''}}"
        loading="{{isLikeSaving}}"
        disabled="{{isLikeSaving}}"
        bindtap="toggleLike"
      >
        <t-icon name="{{likedByMe ? 'heart-filled' : 'heart'}}" size="21px" /><text
          >{{likedByMe ? '你喜欢了这一页' : '给这个瞬间点个赞'}} · {{likeCount}}</text
        >
      </button></view
    >
    <view wx:else class="detail-actions"
      ><button class="detail-edit" disabled="{{isDeleting}}" bindtap="editMemory">
        <t-icon name="edit" size="19px" /><text>编辑这一页</text></button
      ><button
        class="detail-delete"
        loading="{{isDeleting}}"
        disabled="{{isDeleting}}"
        bindtap="deleteMemory"
      >
        {{isDeleting ? '正在删除…' : '删除日记'}}
      </button></view
    >
  </block>
</view>
