<view class="page-shell detail-page">
  <view wx:if="{{isLoading}}" class="detail-skeleton" aria-label="正在打开这段记忆">
    <view class="detail-skeleton__eyebrow"></view>
    <view class="detail-skeleton__title"></view>
    <view class="detail-skeleton__photo"></view>
    <view class="detail-skeleton__line"></view>
    <view class="detail-skeleton__line detail-skeleton__line--short"></view>
  </view>

  <view wx:elif="{{loadError}}" class="ui-state detail-state">
    <text class="detail-state__symbol">!</text>
    <text class="ui-state__title">{{loadErrorTitle}}</text>
    <text class="ui-state__copy">{{loadError}}</text>
    <view class="detail-state__actions">
      <t-button wx:if="{{memoryId}}" theme="primary" bind:tap="loadMemory">重新读取</t-button>
      <button class="ui-text-button" bindtap="returnToMap">返回地图</button>
    </view>
  </view>

  <block wx:elif="{{memory}}">
    <view class="detail-heading page-hero">
      <text class="eyebrow">
        {{isFriendMemory ? ownerDisplayName + ' 的好友回忆' : '我的校园记忆'}}
      </text>
      <text class="page-title">{{displayPlaceName}}</text>
      <text class="page-subtitle">{{formattedRecordedAt}}</text>
    </view>

    <view wx:if="{{photoItems.length}}" class="photo-grid photo-grid--{{photoItems.length}}">
      <view wx:for="{{photoItems}}" wx:key="path" class="photo-frame">
        <image
          wx:if="{{!item.isMissing}}"
          class="memory-photo"
          src="{{item.path}}"
          mode="aspectFill"
          lazy-load="{{true}}"
          data-index="{{index}}"
          binderror="handleImageError"
        />
        <view wx:else class="missing-photo">
          <text class="missing-photo__symbol">◇</text>
          <text class="missing-photo__title">照片无法显示</text>
          <text class="missing-photo__copy">本地文件可能已经丢失</text>
        </view>
      </view>
    </view>

    <view wx:else class="text-memory-cover">
      <text class="text-memory-cover__symbol">记</text>
      <text class="supporting-copy">这是一段没有添加照片的文字记忆</text>
    </view>

    <view class="memory-story">
      <text class="memory-story__label">那天留下的话</text>
      <text wx:if="{{hasText}}" class="memory-text">{{memory.text}}</text>
      <text wx:else class="memory-story__empty">这段记忆只留下了照片。</text>
      <view class="memory-tags">
        <text class="ui-chip">{{categoryLabel}}</text>
        <text class="ui-chip ui-chip--mood">{{moodLabel}}</text>
      </view>
    </view>

    <view class="memory-location">
      <text class="section-title">记忆发生在这里</text>
      <text class="memory-location__copy">{{coordinateLabel}}</text>
      <view class="memory-location__preview" bindtap="showOnMap">
        <image
          class="memory-location__map"
          src="{{mapPreviewSource}}"
          mode="scaleToFill"
          lazy-load="{{true}}"
        />
        <view
          class="memory-location__marker"
          style="left: {{mapPreviewMarkerX}}; top: {{mapPreviewMarkerY}}"
        ></view>
      </view>
      <button class="memory-location__action" bindtap="showOnMap">在地图中查看</button>
    </view>

    <view wx:if="{{actionMessage}}" class="action-message">{{actionMessage}}</view>

    <view wx:if="{{isFriendMemory}}" class="detail-like">
      <button
        class="detail-like__button {{likedByMe ? 'detail-like__button--active' : ''}}"
        loading="{{isLikeSaving}}"
        disabled="{{isLikeSaving}}"
        bindtap="toggleLike"
      >
        {{likedByMe ? '已点赞' : '点赞'}} · {{likeCount}}
      </button>
      <text class="detail-like__copy">只有仍有权限查看这段回忆的好友才能点赞。</text>
    </view>

    <view class="detail-actions">
      <t-button theme="primary" block disabled="{{isDeleting}}" bind:tap="showOnMap"
        >在地图中查看</t-button
      >
      <button
        wx:if="{{!isFriendMemory}}"
        class="detail-actions__edit"
        disabled="{{isDeleting}}"
        bindtap="editMemory"
      >
        编辑
      </button>
    </view>

    <button
      wx:if="{{!isFriendMemory}}"
      class="detail-delete"
      loading="{{isDeleting}}"
      disabled="{{isDeleting}}"
      bindtap="deleteMemory"
    >
      {{isDeleting ? '正在删除' : '删除这段记忆'}}
    </button>
  </block>
</view>
