page {
  background: #f5f3e9;
  background-image: none;
  color: #35402f;
}
button::after {
  border: 0;
}
button {
  background: transparent;
  line-height: 1.5;
  padding: 0;
  color: inherit;
}
.journal-detail {
  padding: 30rpx 30rpx calc(70rpx + env(safe-area-inset-bottom));
}
.detail-caption {
  display: flex;
  justify-content: space-between;
  color: #949c83;
  font-size: 21rpx;
  margin: 0 6rpx 26rpx;
}
.detail-paper {
  background: #fdfcf4;
  padding: 28rpx 32rpx 24rpx;
  border: 1rpx solid #dedfcd;
  box-shadow: 4rpx 7rpx 22rpx rgba(77, 78, 48, 0.06);
  background-image: radial-gradient(#dbdac8 0.8px, transparent 0.8px);
  background-size: 28rpx 28rpx;
}
.detail-paper__head {
  display: flex;
  justify-content: space-between;
  padding-bottom: 18rpx;
  border-bottom: 2rpx solid #72795f;
  font-size: 22rpx;
  color: #747f64;
}
.detail-paper__head > text:last-child {
  font-size: 18rpx;
  color: #9ba28b;
}
.detail-mood {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 38rpx 0 36rpx;
  gap: 18rpx;
}
.detail-mood > text {
  font-size: 34rpx;
  font-family: 'Kaiti SC', 'KaiTi', serif;
  padding: 0 14rpx;
  background: linear-gradient(transparent 65%, #e8d69a 65%, #e8d69a 94%, transparent 94%);
}
.detail-writing {
  display: block;
  font-size: 29rpx;
  line-height: 2;
  white-space: pre-wrap;
  word-break: break-all;
  color: #424e37;
  margin-bottom: 30rpx;
}
.detail-writing--empty {
  text-align: center;
  color: #90997c;
  font-size: 25rpx;
}
.detail-photos {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-top: 30rpx;
}
.detail-photo {
  position: relative;
  background: #fffef9;
  border: 14rpx solid #fffef9;
  padding-bottom: 18rpx;
  box-shadow: 2rpx 5rpx 15rpx rgba(59, 69, 40, 0.09);
  margin: 0 12rpx;
}
.detail-photo:nth-child(2n + 1) {
  transform: rotate(-1deg);
}
.detail-photo__tape {
  position: absolute;
  top: -25rpx;
  left: 35%;
  width: 30%;
  height: 31rpx;
  background: rgba(184, 200, 155, 0.55);
  z-index: 1;
  transform: rotate(-3deg);
}
.detail-photo image {
  display: block;
  width: 100%;
  height: auto;
}
.detail-photo__missing {
  height: 210rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #edefe2;
  color: #97a084;
  font-size: 24rpx;
}
.detail-paper__end {
  display: flex;
  flex-wrap: wrap;
  overflow-wrap: anywhere;
  justify-content: space-between;
  gap: 20rpx;
  font-size: 20rpx;
  color: #969f83;
  border-top: 1rpx dashed #d6d8c2;
  padding-top: 20rpx;
  margin-top: 38rpx;
}
.detail-location {
  margin-top: 35rpx;
  background: #eeefe1;
  border: 1rpx solid #dcdfca;
  border-radius: 20rpx;
  padding: 22rpx;
}
.detail-location > view:first-child {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 25rpx;
  color: #738362;
  margin-bottom: 17rpx;
}
.detail-map {
  position: relative;
  overflow: hidden;
  border-radius: 13rpx;
  height: 240rpx;
}
.detail-map-unavailable {
  display: block;
  color: var(--ui-color-text-secondary);
  font-size: 12px;
  line-height: 1.8;
  overflow-wrap: anywhere;
}
.detail-map image {
  display: block;
  width: 100%;
  height: 100%;
}
.detail-map__pin {
  position: absolute;
  transform: translate(-50%, -50%);
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #71865a;
  border: 5rpx solid #fffbe7;
  box-shadow: 0 0 0 12rpx rgba(119, 143, 89, 0.16);
}
.detail-location button {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
  font-size: 23rpx;
  line-height: 2;
  margin-top: 17rpx;
  color: #6b7e52;
}
.detail-no-location {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 22rpx;
  color: #a0a78f;
  padding: 35rpx 0;
}
.detail-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  margin-top: 20rpx;
}
.detail-edit {
  width: 100%;
  background: #e3e9d1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  min-height: 85rpx;
  border-radius: 19rpx;
  font-size: 26rpx;
  color: #667951;
}
.detail-delete {
  font-size: 22rpx;
  color: #af9180;
  line-height: 2.5;
}
.detail-friend button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: #efecd9;
  color: #8b936e;
  font-size: 25rpx;
  border-radius: 18rpx;
  padding: 23rpx;
  margin-top: 20rpx;
}
.detail-friend .is-liked {
  background: #f1e2da;
  color: #b8796d;
}
.detail-message {
  font-size: 23rpx;
  color: #a08362;
  background: #f3e9d7;
  border-radius: 15rpx;
  padding: 20rpx;
  margin: 22rpx 0;
}
.detail-wait {
  min-height: 50vh;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 25rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8b9479;
  line-height: 1.8;
}
.detail-wait__title {
  font-size: 32rpx;
  color: #62744d;
}
.detail-wait button {
  background: #e5ead6;
  border-radius: 13rpx;
  padding: 14rpx 30rpx;
  font-size: 24rpx;
}

.detail-caption,
.detail-paper__head,
.detail-paper__head > text:last-child,
.detail-paper__end,
.detail-no-location,
.detail-writing--empty {
  color: var(--ui-color-text-secondary);
  font-size: 12px;
}
.detail-caption,
.detail-paper__head {
  gap: 12px;
  flex-wrap: wrap;
}
.detail-writing {
  font-size: 15px;
}
.detail-location button,
.detail-edit,
.detail-delete,
.detail-wait button {
  min-height: 44px;
  box-sizing: border-box;
}
.detail-delete {
  padding: 8px 20px;
  color: #965647;
}
