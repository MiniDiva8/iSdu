.detail-page {
  padding-bottom: calc(48px + constant(safe-area-inset-bottom));
  padding-bottom: calc(48px + var(--ui-safe-area-bottom));
}

.detail-heading {
  padding-top: 8px;
}

.detail-skeleton {
  padding-top: 12px;
  animation: detail-skeleton-pulse 1.2s ease-in-out infinite alternate;
}

.detail-skeleton__eyebrow,
.detail-skeleton__title,
.detail-skeleton__photo,
.detail-skeleton__line {
  background: var(--ui-color-surface-secondary);
  border-radius: var(--ui-radius-small);
}

.detail-skeleton__eyebrow {
  width: 96px;
  height: 14px;
}

.detail-skeleton__title {
  width: 54%;
  height: 32px;
  margin-top: 12px;
}

.detail-skeleton__photo {
  width: 100%;
  height: 360px;
  margin-top: 24px;
  border-radius: var(--ui-radius-large);
}

.detail-skeleton__line {
  width: 100%;
  height: 16px;
  margin-top: 24px;
}

.detail-skeleton__line--short {
  width: 70%;
  margin-top: 12px;
}

@keyframes detail-skeleton-pulse {
  from {
    opacity: 0.56;
  }
  to {
    opacity: 1;
  }
}

.detail-state {
  min-height: 420px;
}

.detail-state__symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  color: var(--ui-color-danger);
  font-size: 20px;
  font-weight: 600;
  background: var(--ui-color-danger-soft);
  border-radius: 50%;
}

.detail-state__actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
  width: 180px;
  margin-top: 20px;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 32px;
}

.photo-grid--1 {
  grid-template-columns: 1fr;
}

.photo-grid--3 .photo-frame:first-child {
  grid-column: 1 / -1;
  aspect-ratio: 4 / 3;
}

.photo-frame {
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: var(--ui-color-surface-secondary);
  border-radius: var(--ui-radius-medium);
}

.photo-grid--1 .photo-frame {
  aspect-ratio: 4 / 3;
  max-height: 520px;
}

.memory-photo,
.missing-photo {
  width: 100%;
  height: 100%;
}

.missing-photo {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-text-secondary);
  background: var(--ui-color-surface-secondary);
}

.missing-photo__symbol {
  color: var(--ui-color-danger);
  font-size: 26px;
}

.missing-photo__title {
  margin-top: 8px;
  color: var(--ui-color-text-primary);
  font-size: 15px;
  font-weight: 600;
  line-height: 22px;
}

.missing-photo__copy {
  margin-top: 2px;
  font-size: 13px;
  line-height: 18px;
}

.text-memory-cover {
  display: flex;
  min-height: 220px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 32px;
  background: var(--ui-color-primary-soft);
  border-radius: var(--ui-radius-large);
}

.text-memory-cover__symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  margin-bottom: 12px;
  color: var(--ui-color-primary);
  font-family: serif;
  font-size: 24px;
  background: var(--ui-color-surface);
  border-radius: 50%;
}

.memory-story {
  padding: 0 0 32px;
  border-bottom: 1px solid var(--ui-color-divider);
}

.memory-story__label {
  display: block;
  color: var(--ui-color-primary);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.04em;
  line-height: 18px;
}

.memory-text {
  display: block;
  margin-top: 12px;
  font-size: 17px;
  line-height: 28px;
  white-space: pre-wrap;
  word-break: break-word;
}

.memory-story__empty {
  display: block;
  margin-top: 12px;
  color: var(--ui-color-text-secondary);
  font-size: 15px;
  line-height: 23px;
}

.memory-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 20px;
}

.memory-location {
  padding: 32px 0;
  border-bottom: 1px solid var(--ui-color-divider);
}

.memory-location__copy {
  display: block;
  margin-top: 4px;
  color: var(--ui-color-text-secondary);
  font-size: 14px;
  line-height: 20px;
}

.memory-location__preview {
  position: relative;
  width: 100%;
  max-width: 520px;
  aspect-ratio: 4 / 3;
  margin-top: 16px;
  overflow: hidden;
  background: var(--ui-color-surface-secondary);
  border-radius: var(--ui-radius-medium);
}

.memory-location__map {
  width: 100%;
  height: 100%;
}

.memory-location__marker {
  position: absolute;
  width: 14px;
  height: 14px;
  background: var(--ui-color-primary);
  border: 3px solid var(--ui-color-surface);
  border-radius: 50%;
  box-shadow: 0 0 0 5px rgba(67, 122, 100, 0.18);
  transform: translate(-50%, -50%);
}

.memory-location__action {
  min-width: 44px;
  min-height: 44px;
  padding: 0;
  margin: 8px 0 -8px;
  color: var(--ui-color-primary);
  font-size: 14px;
  font-weight: 500;
  line-height: 44px;
  text-align: left;
  background: transparent;
  border: 0;
}

.memory-location__action::after,
.detail-actions__edit::after,
.detail-delete::after {
  border: 0;
}

.action-message {
  box-sizing: border-box;
  padding: 12px 16px;
  margin-top: 20px;
  color: #775431;
  font-size: 13px;
  line-height: 18px;
  background: var(--ui-color-mood-soft);
  border-radius: var(--ui-radius-small);
}

.detail-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 112px;
  gap: 12px;
  margin-top: 32px;
}

.detail-actions__edit {
  min-height: 48px;
  padding: 0 16px;
  margin: 0;
  color: var(--ui-color-primary);
  font-size: 15px;
  font-weight: 600;
  line-height: 46px;
  background: var(--ui-color-primary-soft);
  border: 0;
  border-radius: 14px;
}

.detail-delete {
  display: block;
  min-width: 44px;
  min-height: 44px;
  padding: 0 12px;
  margin: 24px auto 0;
  color: var(--ui-color-danger);
  font-size: 13px;
  line-height: 44px;
  background: transparent;
  border: 0;
}

.detail-like {
  padding: 16px;
  margin-top: 18px;
  text-align: center;
  background: var(--ui-color-surface);
  border-radius: var(--ui-radius-medium);
}

.detail-like__button {
  min-width: 132px;
  min-height: 44px;
  padding: 0 20px;
  color: var(--ui-color-text-secondary);
  font-size: 14px;
  background: var(--ui-color-surface-secondary);
  border: 0;
  border-radius: var(--ui-radius-pill);
}

.detail-like__button--active {
  color: var(--ui-color-primary-strong);
  background: var(--ui-color-primary-soft);
}

.detail-like__button::after {
  border: 0;
}

.detail-like__copy {
  display: block;
  margin-top: 8px;
  color: var(--ui-color-text-tertiary);
  font-size: 12px;
  line-height: 18px;
}

@media (max-width: 340px) {
  .detail-actions {
    grid-template-columns: minmax(0, 1fr) 96px;
  }
}
