<view class="page-shell timeline-page">
  <view class="timeline-heading page-hero">
    <text class="eyebrow">沿着时间慢慢回看</text>
    <text class="page-title">{{timelineTitle}}</text>
    <text class="page-subtitle">按时间整理，也能回到地图上的原位置。</text>
  </view>

  <view class="timeline-profile">
    <view class="timeline-profile__avatar">{{profileInitial}}</view>
    <view class="timeline-profile__body">
      <text class="timeline-profile__name">{{profileDisplayName || '给自己取个名字'}}</text>
      <text class="timeline-profile__signature">
        {{profileSignature || '写下一句属于你的校园签名'}}
      </text>
    </view>
    <button class="ui-text-button" disabled="{{isProfileLoading}}" bindtap="openProfileEditor">
      {{isProfileLoading ? '读取中' : profileButtonLabel}}
    </button>
  </view>

  <view wx:if="{{isProfileEditorOpen}}" class="timeline-profile-editor">
    <view class="timeline-profile-editor__heading">
      <view>
        <text class="timeline-profile-editor__title">编辑个人资料</text>
        <text class="timeline-profile-editor__hint">资料只保存在这台设备。</text>
      </view>
      <button
        class="timeline-profile-editor__close"
        disabled="{{isProfileSaving}}"
        bindtap="cancelProfileEditor"
      >
        ×
      </button>
    </view>

    <text class="timeline-profile-editor__label">名字</text>
    <input
      class="timeline-profile-editor__input"
      value="{{profileDraftName}}"
      maxlength="{{profileNameMaxLength}}"
      placeholder="例如：小忆"
      disabled="{{isProfileSaving}}"
      bindinput="handleProfileNameInput"
    />
    <text class="timeline-profile-editor__counter"
      >{{profileDraftName.length}} / {{profileNameMaxLength}}</text
    >

    <text class="timeline-profile-editor__label timeline-profile-editor__label--signature"
      >个性签名</text
    >
    <textarea
      class="timeline-profile-editor__textarea"
      value="{{profileDraftSignature}}"
      maxlength="{{profileSignatureMaxLength}}"
      placeholder="例如：把校园里的每一天，好好收起来。"
      auto-height="{{false}}"
      disabled="{{isProfileSaving}}"
      bindinput="handleProfileSignatureInput"
    />
    <text class="timeline-profile-editor__counter"
      >{{profileDraftSignature.length}} / {{profileSignatureMaxLength}}</text
    >

    <text wx:if="{{profileErrorMessage}}" class="timeline-profile-editor__error"
      >{{profileErrorMessage}}</text
    >
    <view class="timeline-profile-editor__actions">
      <button
        class="timeline-profile-editor__cancel"
        disabled="{{isProfileSaving}}"
        bindtap="cancelProfileEditor"
      >
        取消
      </button>
      <t-button theme="primary" block loading="{{isProfileSaving}}" bind:tap="saveProfile"
        >保存资料</t-button
      >
    </view>
  </view>

  <view wx:if="{{profileErrorMessage && !isProfileEditorOpen}}" class="timeline-profile-warning">
    <text>{{profileErrorMessage}}</text>
    <button bindtap="openProfileEditor">重新设置</button>
  </view>

  <view class="timeline-data-note">
    <view>
      <text class="timeline-data-note__title">仅保存在这台设备</text>
      <text class="timeline-data-note__copy">没有云端备份；换设备或清除数据后可能无法恢复。</text>
    </view>
    <button class="ui-text-button" bindtap="openDataManagement">数据管理</button>
  </view>

  <view wx:if="{{!isLoading && !errorMessage && !isEmpty}}" class="timeline-search">
    <view class="timeline-search__field">
      <text class="timeline-search__icon">⌕</text>
      <input
        class="timeline-search__input"
        value="{{keyword}}"
        maxlength="50"
        confirm-type="search"
        placeholder="搜索地点、文字或心情"
        bindinput="handleKeywordInput"
      />
      <button
        wx:if="{{keyword}}"
        class="timeline-search__clear"
        aria-label="清除搜索"
        bindtap="clearKeyword"
      >
        ×
      </button>
    </view>
    <text class="timeline-search__result">
      {{keyword ? '找到 ' + resultCount + ' 条回忆' : '共 ' + resultCount + ' 条回忆'}}
    </text>
  </view>

  <view wx:if="{{isLoading}}" class="timeline-skeleton" aria-label="正在整理时光">
    <view class="timeline-skeleton__month"></view>
    <view class="timeline-skeleton__card">
      <view class="timeline-skeleton__image"></view>
      <view class="timeline-skeleton__lines"> <view></view><view></view><view></view> </view>
    </view>
    <view class="timeline-skeleton__card">
      <view class="timeline-skeleton__image"></view>
      <view class="timeline-skeleton__lines"> <view></view><view></view><view></view> </view>
    </view>
  </view>

  <view wx:elif="{{errorMessage}}" class="ui-state timeline-state">
    <text class="timeline-state__symbol timeline-state__symbol--error">!</text>
    <text class="ui-state__title">时光暂时没有打开</text>
    <text class="ui-state__copy">{{errorMessage}}</text>
    <view class="timeline-state__action">
      <t-button theme="primary" bind:tap="loadTimeline">重新读取</t-button>
    </view>
  </view>

  <view wx:elif="{{isEmpty}}" class="ui-state timeline-state">
    <text class="timeline-state__symbol">记</text>
    <text class="ui-state__title">这里还没有留下记忆</text>
    <text class="ui-state__copy">去地图上标记属于你的第一段校园时光。</text>
    <view class="timeline-state__action">
      <t-button theme="primary" bind:tap="goToRecord">去地图记录</t-button>
    </view>
  </view>

  <view wx:elif="{{isSearchEmpty}}" class="ui-state timeline-state">
    <text class="timeline-state__symbol">⌕</text>
    <text class="ui-state__title">没有找到相关回忆</text>
    <text class="ui-state__copy">换一个关键词，或者清除搜索看看。</text>
    <button class="ui-text-button timeline-state__text-action" bindtap="clearKeyword">
      清除搜索
    </button>
  </view>

  <block wx:else>
    <view wx:for="{{groups}}" wx:key="key" class="timeline-month">
      <view class="timeline-month__heading">
        <text class="timeline-month__title">{{item.title}}</text>
        <text class="timeline-month__count">{{item.countLabel}}</text>
      </view>

      <view class="timeline-list">
        <view
          wx:for="{{item.items}}"
          wx:for-item="memory"
          wx:key="id"
          class="timeline-card"
          data-memory-id="{{memory.id}}"
          bindtap="openDetail"
        >
          <image
            wx:if="{{memory.hasImage && !memory.imageFailed}}"
            class="timeline-card__image"
            src="{{memory.imagePath}}"
            mode="aspectFill"
            lazy-load="{{true}}"
            data-memory-id="{{memory.id}}"
            catchtap="openDetail"
            binderror="handleImageError"
          />
          <view wx:else class="timeline-card__placeholder"><text>记</text></view>

          <view class="timeline-card__body">
            <view class="timeline-card__topline">
              <text class="timeline-card__date">{{memory.dateLabel}}</text>
              <text wx:if="{{memory.isDemo}}" class="timeline-card__demo">演示</text>
            </view>
            <text class="timeline-card__place">{{memory.placeLabel}}</text>
            <text class="timeline-card__summary">{{memory.summary}}</text>
            <view class="timeline-card__footer">
              <view class="timeline-card__tags">
                <text class="ui-chip">{{memory.categoryLabel}}</text>
                <text class="ui-chip ui-chip--mood">{{memory.moodLabel}}</text>
              </view>
              <button
                class="timeline-card__map-action"
                data-memory-id="{{memory.id}}"
                catchtap="showOnMap"
              >
                在地图中查看
              </button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{actionMessage}}" class="timeline-message">{{actionMessage}}</view>
</view>
