.timeline-page {
  padding-bottom: calc(40px + constant(safe-area-inset-bottom));
  padding-bottom: calc(40px + var(--ui-safe-area-bottom));
}

.timeline-heading {
  padding-top: 8px;
}

.timeline-profile {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 0 20px;
  margin-bottom: 20px;
  border-bottom: 1px solid var(--ui-color-divider);
}

.timeline-profile__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 48px;
  width: 48px;
  height: 48px;
  color: var(--ui-color-surface);
  font-size: 18px;
  font-weight: 600;
  background: var(--ui-color-primary);
  border-radius: 50%;
}

.timeline-profile__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.timeline-profile__name {
  overflow: hidden;
  font-size: 16px;
  font-weight: 600;
  line-height: 22px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline-profile__signature {
  display: -webkit-box;
  margin-top: 2px;
  overflow: hidden;
  color: var(--ui-color-text-secondary);
  font-size: 13px;
  line-height: 18px;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.timeline-profile-editor {
  box-sizing: border-box;
  padding: 20px;
  margin-bottom: 20px;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-divider);
  border-radius: var(--ui-radius-large);
  box-shadow: var(--ui-shadow-floating);
}

.timeline-profile-editor__heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 20px;
}

.timeline-profile-editor__title,
.timeline-profile-editor__hint,
.timeline-profile-editor__label,
.timeline-profile-editor__counter,
.timeline-profile-editor__error {
  display: block;
}

.timeline-profile-editor__title {
  font-size: 18px;
  font-weight: 600;
  line-height: 24px;
}

.timeline-profile-editor__hint {
  margin-top: 4px;
  color: var(--ui-color-text-secondary);
  font-size: 13px;
  line-height: 18px;
}

.timeline-profile-editor__close {
  width: 44px;
  height: 44px;
  padding: 0;
  margin: -10px -10px 0 0;
  color: var(--ui-color-text-secondary);
  font-size: 24px;
  line-height: 42px;
  background: transparent;
  border: 0;
}

.timeline-profile-editor__close::after,
.timeline-profile-warning button::after,
.timeline-profile-editor__cancel::after {
  border: 0;
}

.timeline-profile-editor__label {
  margin-bottom: 8px;
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
}

.timeline-profile-editor__label--signature {
  margin-top: 20px;
}

.timeline-profile-editor__input,
.timeline-profile-editor__textarea {
  box-sizing: border-box;
  width: 100%;
  color: var(--ui-color-text-primary);
  font-size: 15px;
  background: var(--ui-color-background-alt);
  border: 1px solid var(--ui-color-divider);
  border-radius: var(--ui-radius-small);
}

.timeline-profile-editor__input {
  height: 46px;
  padding: 0 14px;
  line-height: 46px;
}

.timeline-profile-editor__textarea {
  height: 112px;
  min-height: 112px;
  padding: 12px 14px;
  line-height: 23px;
}

.timeline-profile-editor__counter {
  margin-top: 4px;
  color: var(--ui-color-text-tertiary);
  font-size: 12px;
  line-height: 18px;
  text-align: right;
}

.timeline-profile-editor__error {
  margin-top: 12px;
  color: var(--ui-color-danger);
  font-size: 13px;
  line-height: 18px;
}

.timeline-profile-editor__actions {
  display: grid;
  grid-template-columns: 112px minmax(0, 1fr);
  gap: 12px;
  margin-top: 20px;
}

.timeline-profile-editor__cancel {
  min-height: 48px;
  padding: 0 12px;
  margin: 0;
  color: var(--ui-color-text-secondary);
  font-size: 15px;
  line-height: 46px;
  background: transparent;
  border: 0;
}

.timeline-profile-warning,
.timeline-message {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  box-sizing: border-box;
  padding: 12px 16px;
  margin-bottom: 20px;
  color: #775431;
  font-size: 13px;
  line-height: 18px;
  background: var(--ui-color-mood-soft);
  border-radius: var(--ui-radius-small);
}

.timeline-profile-warning button {
  flex: none;
  min-width: 44px;
  min-height: 44px;
  padding: 0 8px;
  margin: -12px -8px -12px 0;
  color: inherit;
  font-size: 13px;
  line-height: 44px;
  background: transparent;
  border: 0;
}

.timeline-data-note {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 0;
  margin: -8px 0 24px;
  border-bottom: 1px solid var(--ui-color-divider);
}

.timeline-data-note__title,
.timeline-data-note__copy {
  display: block;
}

.timeline-data-note__title {
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
}

.timeline-data-note__copy {
  margin-top: 2px;
  color: var(--ui-color-text-secondary);
  font-size: 12px;
  line-height: 18px;
}

.timeline-search {
  margin-bottom: 32px;
}

.timeline-search__field {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 46px;
  padding: 0 12px;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-divider);
  border-radius: 14px;
}

.timeline-search__icon {
  flex: none;
  margin-right: 8px;
  color: var(--ui-color-primary);
  font-size: 20px;
  line-height: 1;
}

.timeline-search__input {
  min-width: 0;
  height: 44px;
  flex: 1;
  color: var(--ui-color-text-primary);
  font-size: 15px;
  line-height: 44px;
}

.timeline-search__clear {
  flex: none;
  width: 44px;
  height: 44px;
  padding: 0;
  margin: 0 -10px 0 0;
  color: var(--ui-color-text-secondary);
  font-size: 22px;
  line-height: 42px;
  background: transparent;
  border: 0;
}

.timeline-search__clear::after,
.timeline-card__map-action::after {
  border: 0;
}

.timeline-search__result {
  display: block;
  margin-top: 8px;
  color: var(--ui-color-text-tertiary);
  font-size: 13px;
  line-height: 18px;
}

.timeline-skeleton {
  animation: skeleton-pulse 1.2s ease-in-out infinite alternate;
}

.timeline-skeleton__month {
  width: 132px;
  height: 24px;
  margin-bottom: 16px;
  background: var(--ui-color-surface-secondary);
  border-radius: var(--ui-radius-small);
}

.timeline-skeleton__card {
  display: flex;
  gap: 16px;
  padding: 16px 0;
  border-top: 1px solid var(--ui-color-divider);
}

.timeline-skeleton__image {
  flex: 0 0 112px;
  width: 112px;
  height: 112px;
  background: var(--ui-color-surface-secondary);
  border-radius: var(--ui-radius-medium);
}

.timeline-skeleton__lines {
  flex: 1;
}

.timeline-skeleton__lines view {
  width: 100%;
  height: 14px;
  margin: 10px 0;
  background: var(--ui-color-surface-secondary);
  border-radius: var(--ui-radius-small);
}

.timeline-skeleton__lines view:nth-child(2) {
  width: 72%;
}

.timeline-skeleton__lines view:nth-child(3) {
  width: 48%;
}

@keyframes skeleton-pulse {
  from {
    opacity: 0.56;
  }
  to {
    opacity: 1;
  }
}

.timeline-state {
  min-height: 360px;
}

.timeline-state__symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  color: var(--ui-color-primary);
  font-family: serif;
  font-size: 22px;
  background: var(--ui-color-primary-soft);
  border-radius: 50%;
}

.timeline-state__symbol--error {
  color: var(--ui-color-danger);
  background: var(--ui-color-danger-soft);
}

.timeline-state__action {
  width: 180px;
  margin-top: 20px;
}

.timeline-state__text-action {
  margin-top: 12px;
}

.timeline-month + .timeline-month {
  margin-top: 32px;
}

.timeline-month__heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 0 12px;
}

.timeline-month__title {
  font-size: 20px;
  font-weight: 600;
  line-height: 28px;
}

.timeline-month__count {
  color: var(--ui-color-text-secondary);
  font-size: 13px;
  line-height: 18px;
}

.timeline-list {
  border-top: 1px solid var(--ui-color-divider);
}

.timeline-card {
  display: flex;
  gap: 16px;
  box-sizing: border-box;
  padding: 16px 0;
  overflow: hidden;
  border-bottom: 1px solid var(--ui-color-divider);
  transition:
    opacity 140ms ease,
    transform 140ms ease;
}

.timeline-card:active {
  opacity: 0.82;
  transform: scale(0.99);
}

.timeline-card__image,
.timeline-card__placeholder {
  flex: 0 0 112px;
  width: 112px;
  height: 112px;
  border-radius: var(--ui-radius-medium);
}

.timeline-card__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-primary);
  font-family: serif;
  font-size: 26px;
  background: var(--ui-color-primary-soft);
}

.timeline-card__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.timeline-card__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.timeline-card__date {
  color: var(--ui-color-text-tertiary);
  font-size: 12px;
  line-height: 18px;
}

.timeline-card__demo {
  padding: 2px 8px;
  color: #775431;
  font-size: 12px;
  line-height: 18px;
  background: var(--ui-color-mood-soft);
  border-radius: var(--ui-radius-pill);
}

.timeline-card__place {
  margin-top: 4px;
  overflow: hidden;
  font-size: 18px;
  font-weight: 600;
  line-height: 24px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline-card__summary {
  display: -webkit-box;
  margin-top: 4px;
  overflow: hidden;
  color: var(--ui-color-text-secondary);
  font-size: 14px;
  line-height: 20px;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.timeline-card__footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8px;
  margin-top: auto;
}

.timeline-card__tags {
  display: flex;
  min-width: 0;
  gap: 6px;
  overflow: hidden;
}

.timeline-card__map-action {
  flex: none;
  min-height: 44px;
  padding: 0;
  margin: 0 0 -10px;
  color: var(--ui-color-primary);
  font-size: 12px;
  font-weight: 400;
  line-height: 44px;
  background: transparent;
  border: 0;
}

.timeline-message {
  margin-top: 20px;
  margin-bottom: 0;
}

.timeline-profile__actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.timeline-profile__actions .timeline-profile__edit {
  flex: none;
}

@media (max-width: 380px) {
  .timeline-card__image,
  .timeline-card__placeholder {
    flex-basis: 92px;
    width: 92px;
    height: 92px;
  }

  .timeline-card__footer {
    align-items: flex-start;
    flex-direction: column;
  }

  .timeline-card__map-action {
    min-height: 32px;
    margin: 0;
    line-height: 32px;
  }
}

@media (min-width: 640px) {
  .timeline-card__image,
  .timeline-card__placeholder {
    flex-basis: 136px;
    width: 136px;
    height: 120px;
  }
}
