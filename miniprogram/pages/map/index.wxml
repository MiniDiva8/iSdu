<view class="map-page">
  <view class="map-hero">
    <text class="eyebrow">我的校园回忆</text>
    <text class="map-page-title">记忆星图</text>
    <text class="map-page-subtitle">在熟悉的地方，留下属于你的回忆。</text>
  </view>

  <view class="map-stage">
    <view class="map-frame" style="width: {{viewportWidth}}px; height: {{viewportHeight}}px">
      <movable-area id="map-viewport" class="map-viewport" scale-area="{{true}}">
        <movable-view
          class="map-canvas"
          style="width: {{mapCanvasWidth}}px; height: {{mapCanvasHeight}}px"
          direction="all"
          inertia="{{false}}"
          out-of-bounds="{{false}}"
          damping="24"
          friction="2"
          scale="{{true}}"
          scale-min="{{minScale}}"
          scale-max="{{maxScale}}"
          scale-value="{{viewScale}}"
          x="{{viewX}}"
          y="{{viewY}}"
          animation="{{false}}"
          bindchange="handleViewChange"
          bindscale="handleScale"
          bindtouchstart="handleMapTouchStart"
          bindtouchend="handleMapTouchEnd"
          bindtouchcancel="handleMapTouchEnd"
        >
          <image
            wx:if="{{mapSource}}"
            id="map-image"
            class="map-image"
            style="left: {{mapOffsetX}}px; top: {{mapOffsetY}}px; width: {{mapRenderWidth}}px; height: {{mapRenderHeight}}px"
            src="{{mapSource}}"
            mode="scaleToFill"
            bindload="handleMapLoad"
            binderror="handleMapError"
          />

          <view
            wx:if="{{isMapReady && !isPickingLocation}}"
            class="marker-layer"
            style="left: {{mapOffsetX}}px; top: {{mapOffsetY}}px; width: {{mapRenderWidth}}px; height: {{mapRenderHeight}}px"
          >
            <button
              wx:for="{{markers}}"
              wx:key="renderKey"
              class="memory-marker memory-marker--{{markerMode}} memory-marker--mood-{{item.moodClass}} {{selectedMemory && selectedMemory.id === item.id ? 'memory-marker--selected' : ''}}"
              style="left: {{item.x}}px; top: {{item.y}}px; transform: translate(-50%, -50%) scale({{markerVisualScale}})"
              aria-label="查看回忆：{{item.title}}"
              data-memory-id="{{item.id}}"
              catchtap="handleMarkerTap"
            >
              <image
                wx:if="{{item.showThumbnail && !item.thumbnailFailed}}"
                class="memory-marker__photo"
                src="{{item.thumbnail}}"
                mode="aspectFill"
                lazy-load="{{true}}"
                data-memory-id="{{item.id}}"
                binderror="handleMarkerImageError"
              />
              <view wx:else class="memory-marker__dot"></view>
            </button>
          </view>
        </movable-view>
      </movable-area>

      <view wx:if="{{isPickingLocation && isMapReady}}" class="map-crosshair" aria-hidden="true">
        <view class="map-crosshair__ring"></view>
        <view class="map-crosshair__dot"></view>
      </view>

      <view wx:if="{{isMapLoading}}" class="map-state-overlay">
        <view class="loading-spinner"></view>
        <text class="map-state-title">正在打开校园地图</text>
        <text class="map-state-copy">稍等一下，回忆正在回到原来的位置。</text>
      </view>

      <view wx:if="{{isMapError}}" class="map-state-overlay map-state-overlay--error">
        <text class="map-state-symbol">!</text>
        <text class="map-state-title">地图暂时没有打开</text>
        <text class="map-state-copy">你的回忆仍然安全保存在本机，可以稍后重试。</text>
        <view class="map-state-action">
          <t-button theme="primary" bind:tap="retryMap">重新加载</t-button>
        </view>
      </view>

      <view wx:if="{{isMapReady && !isPickingLocation}}" class="map-floating-tools">
        <button
          class="map-floating-control {{activeFilterCount ? 'map-floating-control--active' : ''}}"
          bindtap="toggleFilterPanel"
        >
          筛选<text wx:if="{{activeFilterCount}}"> · {{activeFilterCount}}</text>
        </button>
        <text class="map-memory-count">{{visibleMarkerCount}} 段回忆</text>
      </view>

      <scroll-view
        wx:if="{{filterPanelOpen && isMapReady && !isPickingLocation}}"
        class="map-filter-panel"
        scroll-y
        enhanced
        show-scrollbar="{{false}}"
        catchtap="stopEvent"
      >
        <view class="map-filter-panel__head">
          <view>
            <text class="map-filter-panel__title">筛选地图回忆</text>
            <text class="map-filter-panel__count">
              当前显示 {{visibleMarkerCount}} / {{availableMarkerCount}} 条
            </text>
          </view>
          <button class="map-filter-panel__close" aria-label="关闭筛选" bindtap="closeFilterPanel">
            ×
          </button>
        </view>

        <view class="map-filter-section">
          <text class="map-filter-section__label">日期</text>
          <view class="map-filter-chips">
            <button
              wx:for="{{dateFilterOptions}}"
              wx:key="value"
              class="map-filter-chip {{filterDatePreset === item.value ? 'map-filter-chip--active' : ''}}"
              data-value="{{item.value}}"
              catchtap="handleDatePresetTap"
            >
              {{item.label}}
            </button>
          </view>
          <view wx:if="{{filterDatePreset === 'custom'}}" class="map-date-range">
            <picker
              mode="date"
              value="{{filterCustomStartDate}}"
              bindchange="handleCustomStartDateChange"
            >
              <view class="map-date-picker">{{filterCustomStartDate || '开始日期'}}</view>
            </picker>
            <text>至</text>
            <picker
              mode="date"
              value="{{filterCustomEndDate}}"
              bindchange="handleCustomEndDateChange"
            >
              <view class="map-date-picker">{{filterCustomEndDate || '结束日期'}}</view>
            </picker>
          </view>
        </view>

        <view class="map-filter-section">
          <text class="map-filter-section__label">心情</text>
          <scroll-view class="map-filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="map-filter-chips map-filter-chips--nowrap">
              <button
                wx:for="{{moodFilterOptions}}"
                wx:key="value"
                class="map-filter-chip {{filterMood === item.value ? 'map-filter-chip--active' : ''}}"
                data-value="{{item.value}}"
                catchtap="handleMoodFilterTap"
              >
                {{item.label}}
              </button>
            </view>
          </scroll-view>
        </view>

        <view class="map-filter-section">
          <text class="map-filter-section__label">内容主题</text>
          <scroll-view class="map-filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="map-filter-chips map-filter-chips--nowrap">
              <button
                wx:for="{{categoryFilterOptions}}"
                wx:key="value"
                class="map-filter-chip {{filterCategory === item.value ? 'map-filter-chip--active' : ''}}"
                data-value="{{item.value}}"
                catchtap="handleCategoryFilterTap"
              >
                {{item.label}}
              </button>
            </view>
          </scroll-view>
        </view>

        <view class="map-filter-section">
          <text class="map-filter-section__label">标记样式</text>
          <view class="map-filter-chips">
            <button
              class="map-filter-chip {{markerMode === 'dot' ? 'map-filter-chip--active' : ''}}"
              data-value="dot"
              catchtap="handleMarkerModeTap"
            >
              小圆点
            </button>
            <button
              class="map-filter-chip {{markerMode === 'photo' ? 'map-filter-chip--active' : ''}}"
              data-value="photo"
              catchtap="handleMarkerModeTap"
            >
              小照片
            </button>
          </view>
        </view>

        <view class="map-filter-actions">
          <button class="map-filter-reset" catchtap="resetMapFilters">重置</button>
          <button class="map-filter-apply" catchtap="applyMapFilters">应用筛选</button>
        </view>
      </scroll-view>

      <view wx:if="{{isPickingLocation && isMapReady}}" class="map-pick-hint">
        移动地图，把想记录的位置放到准星下
      </view>
    </view>
  </view>

  <view wx:if="{{hasRepositoryError}}" class="status-banner status-banner--error">
    <text>回忆暂时没有读取成功</text>
    <button class="status-banner__action" bindtap="refreshMemories">重试</button>
  </view>

  <view wx:if="{{hasInvalidMarkers}}" class="status-banner status-banner--warning">
    {{invalidMarkerCount}} 条回忆的位置异常，暂不显示在地图上
  </view>

  <view wx:if="{{hasIncompatibleMapMemories}}" class="status-banner status-banner--warning">
    {{incompatibleMapMemoryCount}} 条旧版地图记忆暂不投射到当前地图
  </view>

  <view wx:if="{{hasNoMarkers && !isMemoryLoading && !hasRepositoryError}}" class="map-empty-state">
    <text class="map-empty-state__title">
      {{activeFilterCount ? '当前筛选下没有回忆' : '这里还没有留下记忆'}}
    </text>
    <text class="map-empty-state__copy">
      {{activeFilterCount ? '调整筛选，就能重新看见其他记忆。' :
      '在地图上标记属于你的第一段校园时光。'}}
    </text>
    <text wx:if="{{!activeFilterCount}}" class="map-empty-state__privacy-copy">
      当前版本的回忆和照片只保存在这台设备，没有云端备份。
    </text>
  </view>

  <view wx:if="{{isPickingLocation}}" class="map-pick-bar">
    <view class="map-pick-bar__copy">
      <text class="map-pick-bar__label">正在选择位置</text>
      <button class="map-pick-bar__cancel" bindtap="cancelPickingLocation">取消</button>
    </view>
    <t-button
      theme="primary"
      block
      loading="{{isNavigatingToEditor}}"
      disabled="{{!isMapReady || isNavigatingToEditor}}"
      bind:tap="confirmPickingLocation"
    >
      确认这个位置
    </t-button>
  </view>

  <view wx:else class="map-primary-actions">
    <t-button theme="primary" block bind:tap="startPickingLocation">记录此处</t-button>
    <button class="map-reset-action" bindtap="resetMapView">回到初始位置</button>
  </view>

  <view wx:if="{{selectedMemory}}" class="memory-sheet-backdrop" catchtap="closeMemoryCard"></view>
  <view wx:if="{{selectedMemory}}" class="memory-sheet">
    <view class="memory-sheet__handle"></view>
    <button class="memory-sheet__close" aria-label="关闭回忆卡片" bindtap="closeMemoryCard">
      ×
    </button>
    <view class="memory-sheet__content">
      <image
        wx:if="{{selectedMemory.hasImage}}"
        class="memory-sheet__image"
        src="{{selectedMemory.imagePath}}"
        mode="aspectFill"
        lazy-load="{{true}}"
        binderror="handleCardImageError"
      />
      <view wx:else class="memory-sheet__placeholder"><text>记</text></view>
      <view class="memory-sheet__body">
        <text class="memory-sheet__place">{{selectedMemory.placeLabel}}</text>
        <text class="memory-sheet__meta">{{selectedMemory.dateLabel}}</text>
        <text class="memory-sheet__preview">{{selectedMemory.text}}</text>
        <view class="memory-sheet__tags">
          <text class="ui-chip">{{selectedMemory.categoryLabel}}</text>
          <text class="ui-chip ui-chip--mood">{{selectedMemory.moodLabel}}</text>
        </view>
      </view>
    </view>
    <view class="memory-sheet__action">
      <t-button theme="primary" block bind:tap="goToDetail">查看这段记忆</t-button>
    </view>
  </view>
</view>
