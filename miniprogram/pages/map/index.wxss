.map-page {
  box-sizing: border-box;
  width: 100%;
  max-width: var(--ui-map-max-width);
  min-height: 100vh;
  padding: 16px 20px 32px;
  padding-bottom: calc(32px + constant(safe-area-inset-bottom));
  padding-bottom: calc(32px + var(--ui-safe-area-bottom));
  margin: 0 auto;
}

.map-hero {
  padding: 0 0 16px;
  text-align: center;
}

.map-page-title {
  display: block;
  font-size: 28px;
  font-weight: 600;
  line-height: 34px;
}

.map-page-subtitle {
  display: block;
  max-width: 520px;
  margin: 4px auto 0;
  color: var(--ui-color-text-secondary);
  font-size: 15px;
  line-height: 23px;
}

.map-stage {
  display: flex;
  justify-content: center;
}

.map-frame {
  position: relative;
  max-width: 100%;
  overflow: hidden;
  background: #e8ede1;
  border: 1px solid var(--ui-color-divider);
  border-radius: var(--ui-radius-large);
}

.map-viewport {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #e8ede1;
}

.map-canvas {
  position: relative;
  overflow: visible;
}

.map-image,
.marker-layer {
  position: absolute;
}

.map-image {
  display: block;
}

.marker-layer {
  z-index: 2;
  pointer-events: none;
}

.memory-marker {
  position: absolute;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 44px;
  height: 44px;
  padding: 0;
  margin: 0;
  overflow: visible;
  line-height: 1;
  background: transparent;
  border: 0;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transform-origin: center;
  pointer-events: auto;
}

.memory-marker::after,
.memory-sheet__close::after,
.map-pick-bar__cancel::after,
.map-reset-action::after,
.status-banner__action::after {
  border: 0;
}

.memory-marker__photo {
  box-sizing: border-box;
  width: 20px;
  height: 20px;
  border: 1px solid var(--ui-color-surface);
  border-radius: 50%;
  transition: transform 180ms ease;
}

.memory-marker__dot {
  box-sizing: border-box;
  width: 8px;
  height: 8px;
  background: var(--memory-marker-color);
  border: 1px solid var(--ui-color-surface);
  border-radius: 50%;
  transition: transform 180ms ease;
}

.friend-memory-marker__dot {
  box-sizing: border-box;
  width: 6px;
  height: 6px;
  background: var(--memory-marker-color);
  border: 1px solid rgba(255, 253, 249, 0.92);
  border-radius: 50%;
  box-shadow: 0 0 0 1px rgba(34, 38, 32, 0.12);
}

.friend-memory-marker.memory-marker--selected .friend-memory-marker__dot {
  box-shadow: 0 0 0 3px rgba(67, 122, 100, 0.2);
  transform: scale(1.12);
}

.memory-marker--selected .memory-marker__dot,
.memory-marker--selected .memory-marker__photo {
  box-shadow: 0 0 0 3px rgba(67, 122, 100, 0.18);
  transform: scale(1.08);
}

.memory-marker--mood-happy,
.memory-marker--mood-excited,
.memory-marker--mood-proud {
  --memory-marker-color: #b98b4c;
}

.memory-marker--mood-calm,
.memory-marker--mood-relaxed,
.memory-marker--mood-grateful,
.memory-marker--mood-inspired {
  --memory-marker-color: #437a64;
}

.memory-marker--mood-nostalgic,
.memory-marker--mood-lonely,
.memory-marker--mood-sad,
.memory-marker--mood-tired,
.memory-marker--mood-custom {
  --memory-marker-color: #7d837b;
}

.map-crosshair {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 7;
  width: 44px;
  height: 44px;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.map-crosshair::before,
.map-crosshair::after {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 1;
  background: rgba(34, 38, 32, 0.54);
  content: '';
  transform: translate(-50%, -50%);
}

.map-crosshair::before {
  width: 1px;
  height: 58px;
}

.map-crosshair::after {
  width: 58px;
  height: 1px;
}

.map-crosshair__ring {
  position: absolute;
  z-index: 2;
  box-sizing: border-box;
  width: 44px;
  height: 44px;
  background: rgba(255, 253, 249, 0.38);
  border: 3px solid var(--ui-color-surface);
  border-radius: 50%;
  box-shadow: 0 0 0 2px var(--ui-color-primary);
}

.map-crosshair__dot {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 3;
  width: 8px;
  height: 8px;
  background: var(--ui-color-primary);
  border: 2px solid var(--ui-color-surface);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.map-state-overlay {
  position: absolute;
  inset: 0;
  z-index: 8;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 24px;
  background: rgba(246, 242, 234, 0.96);
}

.loading-spinner {
  width: 28px;
  height: 28px;
  margin-bottom: 16px;
  border: 3px solid rgba(67, 122, 100, 0.18);
  border-top-color: var(--ui-color-primary);
  border-radius: 50%;
  animation: map-loading-spin 0.9s linear infinite;
}

@keyframes map-loading-spin {
  to {
    transform: rotate(360deg);
  }
}

.map-state-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  margin-bottom: 16px;
  color: var(--ui-color-surface);
  font-size: 16px;
  font-weight: 600;
  background: var(--ui-color-danger);
  border-radius: 50%;
}

.map-state-title {
  font-size: 18px;
  font-weight: 600;
  line-height: 24px;
}

.map-state-copy {
  max-width: 300px;
  margin-top: 8px;
  color: var(--ui-color-text-secondary);
  font-size: 14px;
  line-height: 20px;
  text-align: center;
}

.map-state-action {
  width: 160px;
  margin-top: 20px;
}

.map-floating-tools {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 6;
  display: flex;
  align-items: center;
  gap: 8px;
}

.map-layer-switch {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 6;
  display: flex;
  padding: 3px;
  background: rgba(255, 253, 249, 0.94);
  border: 1px solid var(--ui-color-divider);
  border-radius: var(--ui-radius-pill);
  box-shadow: var(--ui-shadow-floating);
}

.map-layer-switch__button {
  min-height: 32px;
  padding: 0 10px;
  margin: 0;
  color: var(--ui-color-text-secondary);
  font-size: 12px;
  line-height: 30px;
  background: transparent;
  border: 0;
  border-radius: var(--ui-radius-pill);
}

.map-layer-switch__button--active {
  color: var(--ui-color-surface);
  background: var(--ui-color-primary);
}

.map-layer-switch__button::after {
  border: 0;
}

.map-floating-control,
.map-memory-count {
  box-sizing: border-box;
  min-height: 40px;
  padding: 0 14px;
  color: var(--ui-color-primary-strong);
  font-size: 13px;
  font-weight: 500;
  line-height: 38px;
  background: rgba(255, 253, 249, 0.94);
  border: 1px solid var(--ui-color-divider);
  border-radius: var(--ui-radius-pill);
  box-shadow: var(--ui-shadow-floating);
}

.map-floating-control {
  margin: 0;
}

.map-floating-control::after,
.map-filter-panel__close::after,
.map-filter-chip::after,
.map-filter-reset::after,
.map-filter-apply::after {
  border: 0;
}

.map-floating-control--active {
  color: var(--ui-color-surface);
  background: var(--ui-color-primary);
}

.map-filter-panel {
  position: absolute;
  top: 8px;
  right: 8px;
  z-index: 10;
  box-sizing: border-box;
  width: calc(100% - 16px);
  max-height: calc(100% - 16px);
  padding: 20px;
  overflow-y: auto;
  background: rgba(255, 253, 249, 0.98);
  border: 1px solid var(--ui-color-divider);
  border-radius: var(--ui-radius-large);
  box-shadow: var(--ui-shadow-floating);
}

.map-filter-panel__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.map-filter-panel__title,
.map-filter-panel__count {
  display: block;
}

.map-filter-panel__title {
  font-size: 18px;
  font-weight: 600;
  line-height: 24px;
}

.map-filter-panel__count {
  margin-top: 4px;
  color: var(--ui-color-text-secondary);
  font-size: 13px;
  line-height: 18px;
}

.map-filter-panel__close {
  width: 44px;
  height: 44px;
  padding: 0;
  margin: -10px -10px 0 0;
  color: var(--ui-color-text-secondary);
  font-size: 24px;
  line-height: 42px;
  background: transparent;
  border: 0;
}

.map-filter-section {
  margin-top: 20px;
}

.map-filter-section__label {
  display: block;
  margin-bottom: 8px;
  color: var(--ui-color-text-primary);
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
}

.map-filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.map-filter-chips--nowrap {
  display: inline-flex;
  min-width: 100%;
  flex-wrap: nowrap;
  padding-right: 16px;
}

.map-filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.map-filter-chip {
  width: auto;
  min-width: 56px;
  min-height: 36px;
  padding: 0 12px;
  margin: 0;
  color: var(--ui-color-text-secondary);
  font-size: 13px;
  line-height: 34px;
  background: var(--ui-color-surface-secondary);
  border: 1px solid transparent;
  border-radius: var(--ui-radius-pill);
}

.map-filter-chip--active {
  color: var(--ui-color-primary-strong);
  font-weight: 500;
  background: var(--ui-color-primary-soft);
  border-color: rgba(67, 122, 100, 0.16);
}

.map-date-range {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
  color: var(--ui-color-text-secondary);
  font-size: 13px;
}

.map-date-range picker {
  flex: 1;
}

.map-date-picker {
  box-sizing: border-box;
  min-height: 40px;
  padding: 10px 12px;
  text-align: center;
  background: var(--ui-color-surface-secondary);
  border-radius: var(--ui-radius-small);
}

.map-filter-actions {
  display: grid;
  grid-template-columns: 96px minmax(0, 1fr);
  gap: 12px;
  margin-top: 24px;
}

.map-filter-reset,
.map-filter-apply {
  box-sizing: border-box;
  min-height: 44px;
  padding: 0 12px;
  margin: 0;
  font-size: 14px;
  line-height: 42px;
  border: 0;
  border-radius: var(--ui-radius-small);
}

.map-filter-reset {
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-soft);
}

.map-filter-apply {
  color: var(--ui-color-surface);
  font-weight: 600;
  background: var(--ui-color-primary);
}

.map-pick-hint {
  position: absolute;
  top: 12px;
  left: 50%;
  z-index: 6;
  box-sizing: border-box;
  max-width: calc(100% - 32px);
  padding: 8px 12px;
  overflow: hidden;
  color: var(--ui-color-text-primary);
  font-size: 13px;
  line-height: 18px;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: rgba(255, 253, 249, 0.94);
  border: 1px solid var(--ui-color-divider);
  border-radius: var(--ui-radius-pill);
  box-shadow: var(--ui-shadow-floating);
  transform: translateX(-50%);
}

.status-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  box-sizing: border-box;
  margin-top: 12px;
  padding: 12px 16px;
  font-size: 13px;
  line-height: 18px;
  border-radius: var(--ui-radius-small);
}

.status-banner--error {
  color: #8d4743;
  background: var(--ui-color-danger-soft);
}

.status-banner--warning {
  color: #775431;
  background: var(--ui-color-mood-soft);
}

.status-banner__action {
  flex: none;
  min-width: 44px;
  min-height: 44px;
  padding: 0 8px;
  margin: -12px -8px -12px 0;
  color: inherit;
  font-size: 13px;
  font-weight: 600;
  line-height: 44px;
  background: transparent;
  border: 0;
}

.map-empty-state {
  padding: 20px 4px 4px;
}

.map-empty-state__title,
.map-empty-state__copy,
.map-empty-state__privacy-copy {
  display: block;
}

.map-empty-state__title {
  font-size: 17px;
  font-weight: 600;
  line-height: 24px;
}

.map-empty-state__copy {
  margin-top: 4px;
  color: var(--ui-color-text-secondary);
  font-size: 14px;
  line-height: 20px;
}

.map-empty-state__privacy-copy {
  margin-top: 8px;
  color: var(--ui-color-primary-strong);
  font-size: 12px;
  line-height: 18px;
}

.map-primary-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 128px;
  gap: 12px;
  align-items: center;
  margin-top: 16px;
}

.map-reset-action {
  min-height: 48px;
  padding: 0 8px;
  margin: 0;
  color: var(--ui-color-primary);
  font-size: 14px;
  font-weight: 500;
  line-height: 46px;
  background: var(--ui-color-primary-soft);
  border: 0;
  border-radius: 14px;
}

.map-pick-bar {
  box-sizing: border-box;
  padding: 16px;
  margin-top: 16px;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-divider);
  border-radius: var(--ui-radius-large);
  box-shadow: var(--ui-shadow-floating);
}

.map-pick-bar__copy {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.map-pick-bar__label {
  font-size: 15px;
  font-weight: 600;
  line-height: 22px;
}

.map-pick-bar__cancel {
  min-width: 44px;
  min-height: 44px;
  padding: 0;
  margin: -12px 0 -12px;
  color: var(--ui-color-text-secondary);
  font-size: 14px;
  line-height: 44px;
  background: transparent;
  border: 0;
}

.memory-sheet-backdrop {
  position: fixed;
  inset: 0;
  z-index: 18;
  background: rgba(34, 38, 32, 0.18);
}

.memory-sheet {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  box-sizing: border-box;
  width: 100%;
  max-width: 720px;
  padding: 12px 20px 20px;
  padding-bottom: calc(20px + constant(safe-area-inset-bottom));
  padding-bottom: calc(20px + var(--ui-safe-area-bottom));
  margin: 0 auto;
  background: var(--ui-color-surface);
  border-radius: 20px 20px 0 0;
  box-shadow: 0 -8px 24px rgba(35, 45, 38, 0.08);
  animation: memory-sheet-enter 260ms ease-out;
}

@keyframes memory-sheet-enter {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.memory-sheet__handle {
  width: 36px;
  height: 4px;
  margin: 0 auto 12px;
  background: var(--ui-color-divider);
  border-radius: var(--ui-radius-pill);
}

.memory-sheet__close {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 2;
  width: 44px;
  height: 44px;
  padding: 0;
  color: var(--ui-color-text-secondary);
  font-size: 24px;
  line-height: 42px;
  background: transparent;
  border: 0;
}

.memory-sheet__content {
  display: flex;
  gap: 16px;
  padding-right: 32px;
}

.memory-sheet__image,
.memory-sheet__placeholder {
  flex: 0 0 112px;
  width: 112px;
  height: 112px;
  border-radius: var(--ui-radius-medium);
}

.memory-sheet__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ui-color-primary);
  font-family: serif;
  font-size: 26px;
  background: var(--ui-color-primary-soft);
}

.memory-sheet__body {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.memory-sheet__place {
  overflow: hidden;
  font-size: 18px;
  font-weight: 600;
  line-height: 24px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memory-sheet__meta {
  margin-top: 2px;
  color: var(--ui-color-text-tertiary);
  font-size: 13px;
  line-height: 18px;
}

.memory-sheet__preview {
  display: -webkit-box;
  margin-top: 6px;
  overflow: hidden;
  color: var(--ui-color-text-secondary);
  font-size: 14px;
  line-height: 20px;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.memory-sheet__tags {
  display: flex;
  gap: 8px;
  margin-top: auto;
}

.memory-sheet__action {
  margin-top: 16px;
}

@media (max-width: 480px) {
  .map-memory-count {
    display: none;
  }
}

@media (max-width: 340px) {
  .map-page {
    padding-right: 16px;
    padding-left: 16px;
  }

  .map-primary-actions {
    grid-template-columns: minmax(0, 1fr) 112px;
  }

  .memory-sheet__image,
  .memory-sheet__placeholder {
    flex-basis: 92px;
    width: 92px;
    height: 92px;
  }
}

@media (min-width: 768px) {
  .map-page {
    padding-top: 20px;
  }

  .map-hero {
    padding-left: 4px;
  }
}
