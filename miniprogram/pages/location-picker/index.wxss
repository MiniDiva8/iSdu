page {
  background: #f7f5ec;
  background-image: none;
  color: #34412f;
}
.picker-page {
  padding: 44rpx 30rpx 55rpx;
}
.picker-eyebrow {
  font-size: 21rpx;
  color: #8c947c;
  letter-spacing: 2rpx;
}
.picker-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  margin: 12rpx 0 16rpx;
}
.picker-copy {
  display: block;
  color: #7c866d;
  font-size: 25rpx;
  margin-bottom: 35rpx;
}
.picker-map-frame {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  background: #fffdf6;
  border: 1rpx solid #e0dfcf;
  box-shadow: 0 12rpx 40rpx rgba(63, 75, 46, 0.06);
}
.picker-map {
  display: block;
  width: 100%;
  height: auto;
}
.picker-pin {
  position: absolute;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50% 50% 50% 0;
  background: #687c53;
  border: 5rpx solid #fffef4;
  transform: translate(-50%, -100%) rotate(-45deg);
  box-shadow: 0 4rpx 14rpx rgba(38, 55, 30, 0.25);
  pointer-events: none;
}
.picker-pin view {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fff8d6;
  margin: 8rpx;
}
.picker-selected {
  display: flex;
  align-items: center;
  gap: 14rpx;
  justify-content: center;
  font-size: 26rpx;
  color: #5c6e49;
  margin: 35rpx 0 15rpx;
}
.picker-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.8;
  color: #969d87;
  margin: 15rpx 14rpx 30rpx;
}
.picker-error {
  display: block;
  text-align: center;
  font-size: 23rpx;
  color: #b57164;
}
.picker-confirm {
  background: #657a50;
  color: #fffdf0;
  line-height: 88rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  margin-top: 28rpx;
}
.picker-confirm[disabled] {
  background: #d9ddce;
  color: #939a86;
}
.picker-confirm::after {
  border: 0;
}
