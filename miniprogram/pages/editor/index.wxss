.editor-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + var(--sdu-safe-area-bottom));
}

.editor-header {
  margin-bottom: 24rpx;
}

.editor-title {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.25;
}

.editor-subtitle {
  display: block;
  margin-top: 10rpx;
  color: var(--sdu-color-text-secondary);
  font-size: 25rpx;
  line-height: 1.55;
}

.editor-state-card,
.editor-context-card,
.editor-section {
  box-sizing: border-box;
  padding: 28rpx;
  background: var(--sdu-color-paper);
  border: 1rpx solid rgba(63, 116, 95, 0.12);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(64, 57, 45, 0.05);
}

.editor-state-card--error {
  padding-top: 40rpx;
}

.editor-state-card__title {
  color: var(--sdu-color-accent);
  font-size: 28rpx;
  font-weight: 600;
}

.editor-state-card__action {
  margin-top: 24rpx;
}

.editor-context-card {
  background: linear-gradient(145deg, rgba(223, 234, 227, 0.82), rgba(255, 253, 248, 0.96));
}

.editor-context-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.editor-context-row + .editor-context-row {
  margin-top: 14rpx;
}

.editor-context-label {
  color: var(--sdu-color-text-secondary);
  font-size: 23rpx;
}

.editor-context-value {
  color: var(--sdu-color-accent);
  font-size: 23rpx;
  font-weight: 600;
  text-align: right;
}

.editor-section {
  margin-top: 22rpx;
}

.editor-section__heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.editor-section__title {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
}

.editor-section__hint {
  display: block;
  margin-top: 6rpx;
  color: var(--sdu-color-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
}

.editor-section__counter {
  flex: none;
  color: var(--sdu-color-text-secondary);
  font-size: 21rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 22rpx;
}

.photo-item,
.photo-add {
  position: relative;
  box-sizing: border-box;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 20rpx;
}

.photo-item__image,
.photo-item__missing {
  width: 100%;
  height: 100%;
}

.photo-item__missing {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 12rpx;
  color: #8b484d;
  font-size: 19rpx;
  text-align: center;
  background: #f5dedf;
}

.photo-item__remove {
  position: absolute;
  top: 7rpx;
  right: 7rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  padding: 0;
  color: #fff;
  font-size: 28rpx;
  line-height: 1;
  background: rgba(47, 51, 47, 0.72);
  border: 0;
  border-radius: 50%;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0;
  color: var(--sdu-color-accent);
  font-size: 21rpx;
  line-height: 1.4;
  background: var(--sdu-color-accent-soft);
  border: 2rpx dashed rgba(63, 116, 95, 0.34);
}

.photo-add__symbol {
  margin-bottom: 4rpx;
  font-size: 42rpx;
  font-weight: 300;
}

.photo-item__remove::after,
.photo-add::after,
.option-chip::after {
  border: 0;
}

.memory-textarea,
.memory-input {
  box-sizing: border-box;
  width: 100%;
  margin-top: 20rpx;
  color: var(--sdu-color-text-primary);
  font-size: 26rpx;
  background: #faf7f0;
  border: 1rpx solid rgba(63, 116, 95, 0.14);
  border-radius: 18rpx;
}

.memory-textarea {
  height: 260rpx;
  padding: 22rpx;
  line-height: 1.65;
}

.memory-input {
  height: 88rpx;
  padding: 0 22rpx;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 20rpx;
}

.option-chip {
  box-sizing: border-box;
  padding: 16rpx 12rpx;
  color: var(--sdu-color-text-secondary);
  font-size: 23rpx;
  line-height: 1.4;
  background: #faf7f0;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
}

.custom-option-field {
  position: relative;
  margin-top: 16rpx;
}

.custom-option-input {
  margin-top: 0;
  padding-right: 128rpx;
}

.custom-option-counter {
  position: absolute;
  top: 50%;
  right: 20rpx;
  color: var(--sdu-color-text-secondary);
  font-size: 20rpx;
  transform: translateY(-50%);
}

.option-chip--selected {
  color: #315e4d;
  font-weight: 700;
  background: var(--sdu-color-accent-soft);
  border-color: rgba(63, 116, 95, 0.38);
}

.option-chip--friendship.option-chip--selected {
  color: #8b4355;
  background: #f2dfe4;
  border-color: rgba(180, 95, 114, 0.38);
}

.option-chip--study.option-chip--selected {
  color: #3e5680;
  background: #e1e7f1;
  border-color: rgba(82, 110, 157, 0.38);
}

.option-chip--nature.option-chip--selected {
  color: #7b4f2f;
  background: #f4e6d6;
  border-color: rgba(166, 109, 53, 0.38);
}

.option-chip--food.option-chip--selected,
.option-chip--graduation.option-chip--selected {
  color: #81592f;
  background: #f6ead5;
  border-color: rgba(184, 128, 64, 0.38);
}

.option-chip--club.option-chip--selected {
  color: #665080;
  background: #ebe3f2;
  border-color: rgba(116, 86, 150, 0.36);
}

.option-chip--event.option-chip--selected {
  color: #326b6e;
  background: #deeeee;
  border-color: rgba(55, 123, 126, 0.36);
}

.option-chip--custom.option-chip--selected {
  color: #5d5952;
  background: #eeeae2;
  border-color: rgba(93, 89, 82, 0.32);
}

.editor-error {
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  color: #8b484d;
  font-size: 23rpx;
  line-height: 1.5;
  background: #f5dedf;
  border-radius: 18rpx;
}

.editor-actions {
  display: grid;
  grid-template-columns: 1.25fr 1fr;
  gap: 14rpx;
  margin-top: 28rpx;
}

.editor-storage-note {
  display: block;
  margin-top: 20rpx;
  color: var(--sdu-color-text-secondary);
  font-size: 20rpx;
  line-height: 1.55;
  text-align: center;
}
