page {
  background: #f5f3e9;
  background-image: none;
  color: #35402e;
}
button::after {
  border: 0;
}
button {
  background: none;
  padding: 0;
  color: inherit;
  line-height: 1.4;
  border-radius: 0;
}
.journal-editor {
  padding: 24rpx 28rpx 190rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.editor-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 20rpx;
  color: #949a85;
  margin: 0 5rpx 24rpx;
}
.editor-private {
  display: flex;
  align-items: center;
  gap: 5rpx;
  color: #7d896c;
}
.diary-paper {
  background: #fdfcf4;
  border: 1rpx solid #dfdfcd;
  padding: 26rpx 30rpx 18rpx;
  border-radius: 4rpx;
  box-shadow: 3rpx 7rpx 23rpx rgba(79, 74, 44, 0.055);
  background-image:
    linear-gradient(rgba(174, 171, 139, 0.075) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(174, 171, 139, 0.075) 1rpx, transparent 1rpx);
  background-size: 28rpx 28rpx;
}
.diary-paper__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid #5a6450;
  padding: 2rpx 0 15rpx;
}
.diary-paper__head picker > view {
  display: flex;
  align-items: center;
}
.diary-date {
  font-size: 23rpx;
  letter-spacing: 1rpx;
  margin-right: 8rpx;
}
.diary-edition {
  font-size: 18rpx;
  color: #9b9e89;
}
.editor-mood {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15rpx;
  margin: 36rpx auto 20rpx;
  width: 100%;
  overflow: visible;
}
.editor-mood__label {
  font-family: 'Kaiti SC', 'KaiTi', serif;
  font-size: 33rpx;
  letter-spacing: 2rpx;
  background: linear-gradient(transparent 60%, #eadb9c 60%, #eadb9c 94%, transparent 94%);
  padding: 0 12rpx;
}
.editor-mood__hint {
  font-size: 18rpx;
  color: #a0a58f;
}
.diary-writing {
  display: block;
  width: 100%;
  min-height: 280rpx;
  font-size: 29rpx;
  line-height: 1.95;
  color: #3c4632;
  margin: 35rpx 0 30rpx;
  box-sizing: border-box;
}
.editor-photos {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 15rpx;
}
.editor-photo {
  position: relative;
  background: #fffef9;
  border: 7rpx solid #fffef9;
  padding-bottom: 15rpx;
  box-shadow: 0 2rpx 9rpx rgba(68, 76, 45, 0.08);
}
.editor-photo image,
.editor-photo__missing {
  width: 100%;
  height: 175rpx;
  display: block;
}
.editor-photo__missing {
  display: flex;
  align-items: center;
  text-align: center;
  font-size: 20rpx;
  color: #9a9c8c;
  background: #e8e9df;
}
.editor-photo__remove {
  position: absolute;
  right: -12rpx;
  top: -14rpx;
  line-height: 35rpx;
  width: 35rpx;
  height: 35rpx;
  background: #f6f5ed;
  border-radius: 50%;
  font-size: 27rpx;
  box-shadow: 0 2rpx 8rpx rgba(48, 56, 37, 0.15);
}
.editor-paper-end {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
  font-size: 18rpx;
  color: #a1a48f;
}
.editor-tools {
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-bottom: 1rpx solid #dfdfcc;
  padding: 24rpx 0 20rpx;
}
.editor-tools button {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  color: #788366;
}
.editor-tools button[disabled] {
  opacity: 0.45;
}
.editor-place {
  padding: 24rpx 5rpx;
  color: #7f8970;
}
.editor-place__row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.editor-place input {
  font-size: 25rpx;
  flex: 1;
  min-width: 0;
  height: 50rpx;
}
.editor-place__row button {
  font-size: 18rpx;
  color: #9b927a;
  white-space: nowrap;
}
.editor-place > text {
  display: block;
  font-size: 20rpx;
  margin-top: 8rpx;
  color: #9b9f89;
  line-height: 1.8;
}
.editor-options {
  background: #fffdf5;
  border: 1rpx solid #dedfce;
  padding: 26rpx;
  border-radius: 20rpx;
  margin: 8rpx 0 24rpx;
}
.editor-section-title {
  display: block;
  font-size: 25rpx;
  color: #58664a;
  margin: 5rpx 0 17rpx;
  font-weight: 600;
}
.editor-options-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 10rpx 0 24rpx;
}
.editor-options-grid button,
.editor-friends button {
  font-size: 22rpx;
  padding: 12rpx 20rpx;
  background: #f1f1e5;
  border-radius: 14rpx;
  border: 1rpx solid transparent;
}
.editor-options-grid .is-selected,
.editor-friends .is-selected {
  background: #e2e8ce;
  border-color: #acb892;
  color: #4c633b;
}
.editor-friends {
  font-size: 22rpx;
  color: #899274;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.custom-mood-input,
.custom-option-input {
  background: #f4f1df;
  border: 1rpx dashed #d8d7b9;
  border-radius: 12rpx;
  text-align: center;
  font-size: 25rpx;
  padding: 17rpx;
  margin: 16rpx 0;
  color: #6c7255;
}
.editor-mood-only {
  display: block;
  margin: 18rpx auto 30rpx;
  font-size: 23rpx;
  color: #889671;
  line-height: 2;
}
.editor-savebar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 20rpx 30rpx calc(22rpx + env(safe-area-inset-bottom));
  background: rgba(250, 249, 240, 0.97);
  border-top: 1rpx solid #dfdfcf;
  z-index: 10;
}
.editor-draft-button {
  font-size: 23rpx;
  color: #8a9277;
  padding: 18rpx 8rpx;
  min-width: 170rpx;
}
.editor-save {
  background: #6f8056;
  color: #fffdf1;
  flex: 1;
  line-height: 82rpx;
  border-radius: 18rpx;
  font-size: 27rpx;
  letter-spacing: 1rpx;
}
.editor-save[disabled] {
  background: #c5cdb7;
  color: #fffdf2;
}
.editor-error {
  padding: 20rpx 23rpx;
  color: #af6c61;
  background: #f4e9df;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.8;
}
.editor-draft-notice {
  display: block;
  padding: 18rpx 8rpx;
  font-size: 20rpx;
  color: #939c7e;
  line-height: 1.8;
}
.editor-state {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 30rpx;
  min-height: 55vh;
  font-size: 28rpx;
  color: #8a937b;
  text-align: center;
}
.editor-state button {
  background: #e3e8d6;
  border-radius: 15rpx;
  padding: 15rpx 40rpx;
  font-size: 25rpx;
}
.editor-mask {
  position: fixed;
  inset: 0;
  background: rgba(37, 43, 29, 0.32);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.editor-mood-sheet {
  background: #faf8ed;
  width: 100%;
  box-sizing: border-box;
  border-radius: 34rpx 34rpx 0 0;
  padding: 32rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
}
.editor-sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 31rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
}
.editor-sheet-head button {
  height: 55rpx;
  width: 55rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.editor-mood-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30rpx 12rpx;
}
.editor-mood-grid button {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 21rpx;
  color: #768066;
}

.editor-topic-choice {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  border-radius: 25rpx;
  background: #ecebdc;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  text-align: left;
}
.editor-topic-choice > view {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
}
.editor-topic-choice > view > text:first-child {
  font-size: 28rpx;
}
.editor-topic-choice > view > text + text {
  font-size: 20rpx;
  color: #929780;
}
