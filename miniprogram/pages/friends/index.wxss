.friends-invite,
.friends-list {
  padding: 24px 0;
  border-top: 1px solid var(--ui-color-divider);
}

.friends-section__title,
.friends-section__copy,
.friends-message,
.friends-empty,
.friend-row__name,
.friend-row__signature {
  display: block;
}

.friends-section__title {
  font-size: 20px;
  font-weight: 650;
}

.friends-section__copy,
.friends-empty {
  margin-top: 8px;
  color: var(--ui-color-text-secondary);
  font-size: 14px;
  line-height: 21px;
}

.friends-primary-action,
.friends-secondary-action {
  width: 100%;
  min-height: 48px;
  margin: 18px 0 0;
  font-size: 15px;
  font-weight: 600;
  border: 0;
  border-radius: 14px;
}

.friends-primary-action {
  color: #fff;
  background: var(--ui-color-primary);
}

.friends-secondary-action {
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-soft);
}

.friends-primary-action::after,
.friends-secondary-action::after,
.friend-row__remove::after {
  border: 0;
}

.friends-message {
  padding: 12px 16px;
  margin: 16px 0;
  color: var(--ui-color-primary-strong);
  font-size: 13px;
  background: var(--ui-color-primary-soft);
  border-radius: 12px;
}

.friend-row {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 18px 0;
  border-bottom: 1px solid var(--ui-color-divider);
}

.friend-row__avatar {
  display: flex;
  flex: 0 0 44px;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  color: #fff;
  font-weight: 650;
  background: var(--ui-color-primary);
  border-radius: 50%;
}

.friend-row__body {
  min-width: 0;
  flex: 1;
}

.friend-row__name {
  font-size: 16px;
  font-weight: 600;
}

.friend-row__signature {
  overflow: hidden;
  margin-top: 4px;
  color: var(--ui-color-text-secondary);
  font-size: 13px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friend-row__remove {
  padding: 6px 10px;
  color: var(--ui-color-danger);
  font-size: 13px;
  background: transparent;
  border: 0;
}
