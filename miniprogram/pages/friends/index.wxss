.friends-invite,
.friends-list {
  padding: 24px 0;
  border-top: 1px solid var(--ui-color-divider);
}

.friends-section__title,
.friends-section__copy,
.friends-message,
.friends-empty,
.friend-row__name,
.friend-row__signature {
  display: block;
}

.friends-section__title {
  font-size: 20px;
  font-weight: 650;
}

.friends-section__copy,
.friends-empty {
  margin-top: 8px;
  color: var(--ui-color-text-secondary);
  font-size: 14px;
  line-height: 21px;
}

.friends-primary-action,
.friends-secondary-action {
  width: 100%;
  min-height: 48px;
  margin: 18px 0 0;
  font-size: 15px;
  font-weight: 600;
  border: 0;
  border-radius: 14px;
}

.friends-primary-action {
  color: #fff;
  background: var(--ui-color-primary);
}

.friends-secondary-action {
  color: var(--ui-color-primary);
  background: var(--ui-color-primary-soft);
}

.friends-primary-action::after,
.friends-secondary-action::after,
.friend-row__remove::after {
  border: 0;
}

.friends-message {
  padding: 12px 16px;
  margin: 16px 0;
  color: var(--ui-color-primary-strong);
  font-size: 13px;
  background: var(--ui-color-primary-soft);
  border-radius: 12px;
}
.friends-load-error {
  margin-top: 12px;
  color: var(--ui-color-danger);
  font-size: 13px;
  line-height: 1.8;
  overflow-wrap: anywhere;
}

.friend-row {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 18px 0;
  border-bottom: 1px solid var(--ui-color-divider);
}

.friend-row__avatar {
  display: flex;
  flex: 0 0 44px;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  color: #fff;
  font-weight: 650;
  background: var(--ui-color-primary);
  border-radius: 50%;
}

.friend-row__body {
  min-width: 0;
  flex: 1;
}

.friend-row__name {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 16px;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.friend-row__signature {
  overflow: hidden;
  margin-top: 4px;
  color: var(--ui-color-text-secondary);
  font-size: 13px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.friend-row__remove {
  min-height: 44px;
  flex-shrink: 0;
  padding: 6px 10px;
  color: var(--ui-color-danger);
  font-size: 13px;
  background: transparent;
  border: 0;
}

.friend-row__visit {
  min-height: 44px;
  margin: 0 10rpx 0 0;
  flex-shrink: 0;
  background: #eaf0dc;
  border: 1rpx solid #d5dfc3;
  color: #6b7f52;
  font-size: 22rpx;
  padding: 13rpx 17rpx;
  line-height: 1.6;
  border-radius: 30rpx;
}
