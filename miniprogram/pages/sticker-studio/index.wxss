page {
  background: #f5f3e9;
  background-image: none;
  color: #35402e;
}
button {
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  color: inherit;
  background: transparent;
  line-height: 1.4;
  box-sizing: border-box;
  font-weight: 400;
}
button::after {
  border: 0;
}
button[disabled] {
  opacity: 0.38;
  background: transparent;
  color: inherit;
}
.sticker-studio {
  padding: 30rpx 30rpx calc(180rpx + env(safe-area-inset-bottom));
}
.studio-heading {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  align-items: center;
  margin-bottom: 26rpx;
}
.studio-eyebrow {
  display: block;
  font-size: 17rpx;
  letter-spacing: 4rpx;
  color: #8f9b7d;
  margin-bottom: 11rpx;
}
.studio-title {
  font-size: 35rpx;
  font-family: 'Kaiti SC', 'KaiTi', serif;
  letter-spacing: 1rpx;
}
.studio-number {
  border: 1rpx solid #b4bba4;
  padding: 10rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 17rpx;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  transform: rotate(9deg);
  color: #7b8968;
}
.studio-number text {
  display: block;
  font-size: 21rpx;
}
.studio-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  gap: 10rpx;
  font-size: 22rpx;
}
.studio-history {
  display: flex;
  gap: 2rpx;
  background: #fdfbf4;
  border: 1rpx solid #e0e1d3;
  border-radius: 40rpx;
  padding: 2rpx 8rpx;
}
.studio-history button {
  width: 70rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.studio-background {
  display: flex;
  gap: 12rpx;
  align-items: center;
  min-height: 66rpx;
  margin-left: auto;
}
.studio-clear {
  padding: 16rpx 8rpx 16rpx 20rpx;
  color: #8c8877;
}
.sticker-board {
  position: relative;
  padding: 0;
  width: 100%;
  aspect-ratio: 1;
  background: #fdfbf1;
  border: 1rpx solid #dedfcd;
  border-radius: 8rpx;
  box-shadow: 0 8rpx 22rpx rgba(62, 69, 43, 0.06);
  box-sizing: border-box;
  overflow: hidden;
}
.sticker-board--transparent {
  background-color: #fffef9;
  background-image:
    linear-gradient(45deg, #f0eee3 25%, transparent 25%),
    linear-gradient(-45deg, #f0eee3 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #f0eee3 75%),
    linear-gradient(-45deg, transparent 75%, #f0eee3 75%);
  background-size: 30rpx 30rpx;
  background-position:
    0 0,
    0 15rpx,
    15rpx -15rpx,
    -15rpx 0;
}
.sticker-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  touch-action: none;
}
.studio-empty,
.studio-unavailable {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  font-size: 24rpx;
  color: #8b967d;
  pointer-events: none;
}
.studio-empty text:last-child {
  font-size: 20rpx;
  color: #a2a992;
}
.studio-empty__star {
  font-size: 76rpx;
  line-height: 1.2;
  color: #b7bea3;
  margin-bottom: 16rpx;
}
.studio-unavailable {
  pointer-events: auto;
  background: #fdfbf1;
}
.studio-unavailable button {
  color: #526b3d;
  padding: 20rpx;
  text-decoration: underline;
}
.studio-caption {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin: 18rpx 2rpx 24rpx;
  color: #939b84;
  font-size: 19rpx;
  line-height: 1.6;
}
.studio-caption text:last-child {
  flex-shrink: 0;
}
.studio-notice {
  font-size: 23rpx;
  line-height: 1.7;
  color: #a26046;
  background: #f5e8d9;
  border-radius: 10rpx;
  padding: 15rpx 20rpx;
  margin-bottom: 20rpx;
}
.studio-toolbox {
  border: 1rpx solid #e0e2d2;
  background: #fbfaf3;
  border-radius: 22rpx;
  overflow: hidden;
}
.studio-tools {
  display: flex;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid #e8e9dc;
  gap: 4rpx;
}
.studio-tool {
  flex: 1;
  min-width: 0;
  min-height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  color: #8a937c;
  font-size: 22rpx;
  border-radius: 15rpx;
}
.studio-tool--active {
  background: #e8eddd;
  color: #405833;
}
.studio-colors {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  padding: 20rpx 24rpx 10rpx;
}
.studio-field-label {
  color: #929780;
  font-size: 22rpx;
  flex-shrink: 0;
  min-width: 48rpx;
}
.studio-color {
  width: 59rpx;
  height: 59rpx;
  padding: 9rpx;
  border: 1rpx solid transparent;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.studio-color view {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--swatch);
}
.studio-color--active {
  border-color: var(--swatch);
}
.studio-panel {
  padding: 22rpx 25rpx 26rpx;
  min-height: 185rpx;
}
.studio-panel-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  font-size: 23rpx;
}
.studio-panel-heading > text:last-child {
  font-size: 19rpx;
  color: #979b87;
  flex-shrink: 0;
}
.studio-slider-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 15rpx 0;
  min-height: 64rpx;
  font-size: 21rpx;
  color: #8a937a;
}
.studio-slider-row slider {
  flex: 1;
  min-width: 0;
  margin: 14rpx 12rpx;
}
.studio-slider-row > text:last-child {
  width: 68rpx;
  font-size: 20rpx;
  text-align: right;
}
.studio-brush-dot {
  border-radius: 50%;
  flex-shrink: 0;
  margin: 0 10rpx;
}
.studio-panel-tip {
  font-size: 20rpx;
  color: #a0a58e;
  display: block;
  margin-top: 18rpx;
  line-height: 1.6;
}
.studio-text-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 120rpx;
  height: 150rpx;
  padding: 18rpx 20rpx;
  margin: 20rpx 0;
  border: 1rpx solid #e1e4d1;
  border-radius: 10rpx;
  background: #fffef8;
  font-size: 25rpx;
  line-height: 1.7;
}
.studio-phrases {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.studio-phrases button {
  padding: 11rpx 16rpx;
  background: #f0f0e5;
  border-radius: 30rpx;
  font-size: 21rpx;
  color: #848e74;
}
.studio-insert {
  margin-top: 24rpx;
  min-height: 68rpx;
  line-height: 68rpx;
  font-size: 24rpx;
  background: #e7ecdc;
  border-radius: 10rpx;
  color: #52683e;
}
.studio-categories {
  display: flex;
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.studio-categories button {
  flex: 1;
  min-height: 58rpx;
  padding: 12rpx 8rpx;
  font-size: 22rpx;
  color: #9b9f8a;
  border-radius: 30rpx;
}
.studio-categories .studio-category--active {
  background: #e8ecdd;
  color: #4d653a;
}
.studio-stamps {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}
.studio-stamps button {
  background: #f2f2e7;
  padding: 8rpx 2rpx 17rpx;
  border-radius: 14rpx;
  text-align: center;
  font-size: 19rpx;
  color: #7c886c;
}
.stamp-preview {
  display: block;
  width: 100%;
  height: 110rpx;
  pointer-events: none;
}
.studio-stamps button > text {
  display: block;
  font-size: 18rpx;
}
.studio-delete {
  color: #a66d54;
  padding: 8rpx;
  font-size: 22rpx;
}
.studio-select-empty {
  min-height: 170rpx;
  display: flex;
  flex-direction: column;
  gap: 13rpx;
  align-items: center;
  justify-content: center;
  color: #919a81;
  font-size: 23rpx;
}
.studio-select-empty text:last-child {
  font-size: 20rpx;
  color: #a3aa94;
}
.studio-draft-note {
  display: flex;
  align-items: flex-start;
  gap: 9rpx;
  color: #9ba38a;
  font-size: 20rpx;
  line-height: 1.7;
  padding: 22rpx 6rpx;
}
.studio-draft-note t-icon {
  margin-top: 5rpx;
}
.studio-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding: 15rpx 30rpx calc(22rpx + env(safe-area-inset-bottom));
  background: #f5f3e9;
  border-top: 1rpx solid #e1e3d3;
}
.studio-footer > text {
  display: block;
  text-align: center;
  font-size: 19rpx;
  color: #9aa18b;
  margin-bottom: 13rpx;
}
.studio-primary {
  width: 100%;
  min-height: 87rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  background: #536d41;
  color: #fffef6;
  border-radius: 13rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}
.studio-primary[disabled] {
  background: #c4cbb8;
  color: #fffef6;
  opacity: 1;
}
