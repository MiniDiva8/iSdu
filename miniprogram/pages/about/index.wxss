.about-cover {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240px;
  overflow: hidden;
  color: var(--ui-color-surface);
  background: linear-gradient(145deg, var(--ui-color-primary), var(--ui-color-primary-strong));
  border-radius: 24px;
}
.about-orbit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88px;
  height: 58px;
  border: 1px solid rgba(224, 206, 165, 0.6);
  border-radius: 50%;
  transform: rotate(-24deg);
}
.about-star {
  color: #e0cea5;
  font-size: 24px;
  transform: rotate(24deg);
}
.about-wordmark {
  margin-top: 16px;
  font-family: var(--ui-font-display);
  font-size: 38px;
  font-weight: 500;
  line-height: 48px;
  letter-spacing: 0.04em;
}
.about-motto {
  margin-top: 10px;
  color: #d4e4dc;
  font-size: 13px;
  line-height: 24px;
  letter-spacing: 0.12em;
}
.about-story {
  margin-top: 28px;
}
.about-story__title {
  display: block;
  font-size: 17px;
  font-weight: 600;
  line-height: 28px;
}
.about-story__copy {
  display: block;
  margin-top: 12px;
  color: var(--ui-color-text-secondary);
  font-size: 14px;
  line-height: 28px;
}
.about-disclaimer {
  display: block;
  padding-top: 20px;
  margin-top: 32px;
  color: var(--ui-color-text-tertiary);
  border-top: 1px solid var(--ui-color-divider);
  font-size: 12px;
  line-height: 24px;
}
