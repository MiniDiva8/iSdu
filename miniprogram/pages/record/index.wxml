<view class="page-shell record-page">
  <view class="record-intro paper-card">
    <text class="eyebrow">从一个地点开始</text>
    <text class="page-title">今天，想记住校园里的哪里？</text>
    <text class="page-subtitle">{{interactionMessage}}</text>

    <view class="record-steps" aria-label="记录校园回忆的步骤">
      <view class="record-step">
        <text class="record-step__number">1</text>
        <text class="record-step__copy">拖动和缩放地图，让目标地点停在中央</text>
      </view>
      <view class="record-step">
        <text class="record-step__number">2</text>
        <text class="record-step__copy">确认位置后添加照片、文字和心情</text>
      </view>
      <view class="record-step">
        <text class="record-step__number">3</text>
        <text class="record-step__copy">保存后，记忆会留在地图上的原位置</text>
      </view>
    </view>

    <view class="record-action">
      <t-button
        theme="primary"
        block
        loading="{{isNavigating}}"
        disabled="{{isNavigating}}"
        bind:tap="beginMapPick"
      >
        {{isNavigating ? '正在打开地图' : '去地图选择位置'}}
      </t-button>
    </view>
  </view>
</view>
