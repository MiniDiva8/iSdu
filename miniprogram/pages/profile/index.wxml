<view class="profile-page" style="padding-top:{{topInset + 54}}px">
  <view class="profile-nav" style="top:{{topInset}}px"
    ><button bindtap="openJournal" aria-label="返回日记">
      <t-icon name="chevron-left" size="27px" /></button
    ><text>设置</text></view
  >
  <view class="profile-hero">
    <button
      class="profile-avatar"
      data-page="profile-edit"
      bindtap="openSection"
      aria-label="编辑个人资料"
    >
      <view class="profile-avatar-face"><mood-face mood="{{defaultMood}}" size="normal" /></view
      ><text>{{initial}}</text>
    </button>
    <view class="profile-hero-body"
      ><button class="profile-name" data-page="profile-edit" bindtap="openSection">
        {{isLoading ? '正在读取…' : displayName}}
      </button>
      <view class="profile-stats"
        ><view><text>{{insightsReady ? entryCount : '—'}}</text><text>日记数</text></view
        ><view><text>{{insightsReady ? characterCount : '—'}}</text><text>字数</text></view
        ><view
          ><text>{{insightsReady ? currentStreak : '—'}}</text><text>连续天数</text></view
        ></view
      >
    </view>
  </view>
  <text wx:if="{{insightError}}" class="profile-error">{{insightError}}</text>
  <view class="profile-shortcuts">
    <button class="profile-shortcut" bindtap="openMoodDefaults">
      <view><text>我的心情</text><text>{{moodCount}} 种 · {{defaultMoodLabel}}</text></view
      ><mood-face mood="{{defaultMood}}" size="small" />
    </button>
    <button class="profile-shortcut" bindtap="openCategoryDefaults">
      <view><text>日记主题</text><text>{{categoryCount}} 种 · {{defaultCategoryLabel}}</text></view
      ><view class="profile-topic-mark"><t-icon name="book" size="27px" /><view></view></view>
    </button>
  </view>
  <button class="profile-campus-banner" bindtap="openCampus">
    <view class="profile-banner-icon"><t-icon name="location" size="30px" /></view
    ><text>把心情，留在校园里</text><text class="profile-banner-action">去看看</text>
  </button>
  <view class="profile-group">
    <button class="profile-menu-row" data-page="friends" bindtap="openSection">
      <t-icon name="usergroup" size="25px" /><text>我的好友</text
      ><t-icon name="chevron-right" size="23px" />
    </button>
    <button class="profile-menu-row" data-page="album" bindtap="openSection">
      <t-icon name="image" size="25px" /><text>照片墙</text
      ><t-icon name="chevron-right" size="23px" />
    </button>
    <button class="profile-menu-row" data-page="profile-edit" bindtap="openSection">
      <t-icon name="user" size="25px" /><text>个人资料</text
      ><t-icon name="chevron-right" size="23px" />
    </button>
  </view>
  <view class="profile-group">
    <button class="profile-menu-row" data-panel="preferences" bindtap="openPanel">
      <t-icon name="edit" size="25px" /><text>偏好设置</text
      ><t-icon name="chevron-right" size="23px" />
    </button>
    <button class="profile-menu-row" data-page="data-management" bindtap="openSection">
      <t-icon name="lock-on" size="25px" /><text>隐私与数据</text
      ><t-icon name="chevron-right" size="23px" />
    </button>
    <button class="profile-menu-row" bindtap="openCategoryDefaults">
      <t-icon name="book" size="25px" /><text>主题分类</text
      ><t-icon name="chevron-right" size="23px" />
    </button>
    <button class="profile-menu-row" data-panel="stats" bindtap="openPanel">
      <t-icon name="chart-bar" size="25px" /><text>日记图表</text
      ><t-icon name="chevron-right" size="23px" />
    </button>
    <button class="profile-menu-row" data-page="about" bindtap="openSection">
      <t-icon name="info-circle" size="25px" /><text>关于 iSdu</text
      ><t-icon name="chevron-right" size="23px" />
    </button>
  </view>
  <view class="profile-group"
    ><button class="profile-menu-row" data-page="data-management" bindtap="openSection">
      <t-icon name="cloud" size="25px" /><view class="profile-sync-copy"
        ><text>同步与备份</text><text>{{storageLabel}}</text></view
      ><t-icon name="chevron-right" size="23px" /></button
  ></view>
  <view wx:if="{{errorMessage}}" class="profile-error"
    ><text>{{errorMessage}}</text><button bindtap="loadProfile">重新读取</button></view
  >
  <text class="profile-signature">{{signature}}</text>
  <view wx:if="{{panel}}" class="profile-mask" bindtap="closePanel"
    ><view class="profile-sheet" catchtap="noop">
      <view class="profile-sheet-head"
        ><text>{{panel === 'preferences' ? '偏好设置' : '我的日记图表'}}</text
        ><button bindtap="closePanel" aria-label="关闭"><t-icon name="close" size="23px" /></button
      ></view>
      <block wx:if="{{panel === 'preferences'}}">
        <button class="preference-row" bindtap="openMoodDefaults">
          <text>默认心情</text><mood-face mood="{{defaultMood}}" size="tiny" /><text
            >{{defaultMoodLabel}}</text
          ><t-icon name="chevron-right" size="18px" />
        </button>
        <button class="preference-row" bindtap="openCategoryDefaults">
          <text>默认主题</text><text>{{defaultCategoryLabel}}</text
          ><t-icon name="chevron-right" size="18px" />
        </button>
        <view class="preference-row"
          ><view
            ><text>转盘轻振反馈</text
            ><text class="profile-sheet-muted">选中心情时，给一点轻轻的回应</text></view
          ><switch checked="{{haptics}}" color="#788357" bindchange="toggleHaptics"
        /></view>
        <text class="profile-sheet-muted"
          >默认选择仅用于新建日记，已有记录保持原来的心情和主题。</text
        >
      </block>
      <block wx:else>
        <text class="profile-sheet-muted"
          >{{insightsReady ? entryCount + ' 篇日记 · ' + recordedDayCount + ' 天记录 · ' +
          campusPlaceCount + ' 处校园足迹' : (insightError || '正在读取日记统计…')}}</text
        >
        <scroll-view scroll-y class="profile-chart-list"
          ><view wx:for="{{moodCounts}}" wx:key="mood" class="profile-chart-row"
            ><mood-face mood="{{item.mood}}" size="tiny" /><view
              ><view class="profile-chart-label"
                ><text>{{item.label}}</text><text>{{item.count}} 篇</text></view
              ><view class="profile-chart-track"
                ><view style="width:{{item.percentage}}%"></view></view></view></view
          ><text wx:if="{{insightsReady && entryCount === 0}}" class="profile-chart-empty"
            >从第一篇日记开始，慢慢看见自己的心情。</text
          ></scroll-view
        >
      </block>
    </view></view
  >
</view>
