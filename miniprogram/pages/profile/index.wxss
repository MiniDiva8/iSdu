page {
  background: #f6f5ed;
  color: #393b34;
}
button {
  margin: 0;
  padding: 0;
  line-height: 1.4;
  background: transparent;
  color: inherit;
  font-weight: 400;
  border-radius: 0;
}
button::after {
  border: 0;
}
.profile-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 30rpx 45rpx;
  background-color: #f6f5ed;
  background-image:
    linear-gradient(rgba(102, 106, 87, 0.045) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(102, 106, 87, 0.045) 1rpx, transparent 1rpx);
  background-size: 38rpx 38rpx;
}
.profile-nav {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.profile-nav > text {
  font-size: 29rpx;
  font-weight: 600;
}
.profile-nav > button {
  position: absolute;
  left: 0;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}
.profile-hero {
  display: flex;
  gap: 22rpx;
  align-items: center;
  margin: 22rpx 0 30rpx;
  min-height: 178rpx;
}
.profile-avatar-motion {
  display: inline-flex;
  width: 176rpx;
  height: 178rpx;
  flex-shrink: 0;
  align-items: center;
}
.profile-avatar {
  position: relative;
  width: 176rpx;
  height: 178rpx;
  flex-shrink: 0;
  border: 4rpx solid #42443d;
  border-radius: 47% 51% 46% 45%/48% 53% 45% 47%;
  box-sizing: border-box;
  transform: rotate(-4deg);
  overflow: hidden;
}
.profile-avatar-face {
  position: absolute;
  left: 15rpx;
  bottom: 16rpx;
  opacity: 0.42;
  filter: grayscale(0.75);
  transform: rotate(7deg);
}
.profile-avatar > text {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  font-family: 'Kaiti SC', 'KaiTi', serif;
  font-size: 39rpx;
  color: #747769;
  opacity: 0.65;
}
.profile-hero-body {
  flex: 1;
  min-width: 0;
}
.profile-name {
  text-align: left;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  min-height: 44px;
  overflow-wrap: anywhere;
  margin-bottom: 25rpx;
}
.profile-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 5rpx;
}
.profile-stats > view {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5rpx;
}
.profile-stats > view > text:first-child {
  font-size: 30rpx;
  font-weight: 600;
}
.profile-stats > view > text + text {
  font-size: 21rpx;
  color: #97998d;
  white-space: nowrap;
}
.profile-shortcuts {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin: 0 0 26rpx;
}
.profile-shortcut {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #eeeee5;
  min-height: 124rpx;
  border-radius: 38rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  text-align: left;
  gap: 8rpx;
}
.profile-shortcut > view:first-child {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  gap: 6rpx;
}
.profile-shortcut > view:first-child > text:first-child {
  font-size: 28rpx;
  font-weight: 600;
}
.profile-shortcut > view:first-child > text + text {
  font-size: 21rpx;
  color: #676c5e;
}
.profile-topic-mark {
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 60rpx;
  position: relative;
  color: #a09b66;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(7deg);
}
.profile-topic-mark > view {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  bottom: -4rpx;
  height: 11rpx;
  border-radius: 50%;
  background: #e6d699;
  z-index: -1;
}
.profile-campus-banner {
  width: 100%;
  display: flex;
  gap: 13rpx;
  align-items: center;
  padding: 20rpx 22rpx;
  background-color: #f5edcf;
  background-image: radial-gradient(#fff9e3 2rpx, transparent 2rpx);
  background-size: 24rpx 24rpx;
  border-radius: 40rpx;
  box-sizing: border-box;
  min-height: 105rpx;
  margin-bottom: 28rpx;
  text-align: left;
}
.profile-banner-icon {
  color: #5b6150;
  display: flex;
}
.profile-campus-banner > text:nth-child(2) {
  font-size: 26rpx;
  font-weight: 600;
  flex: 1;
}
.profile-banner-action {
  background: #f8da80;
  border-radius: 40rpx;
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  white-space: nowrap;
}
.profile-group {
  background: #eeeee5;
  border-radius: 42rpx;
  padding: 10rpx 26rpx;
  margin-bottom: 26rpx;
  overflow: hidden;
}
.profile-menu-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  min-height: 100rpx;
  width: 100%;
  text-align: left;
}
.profile-menu-row > text,
.profile-menu-row > .profile-sync-copy {
  flex: 1;
  font-size: 28rpx;
}
.profile-menu-row > t-icon:last-child {
  flex-shrink: 0;
}
.profile-sync-copy {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}
.profile-sync-copy > text + text {
  font-size: 20rpx;
  color: #8a8e7d;
}
.profile-signature {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: #929788;
  margin: 30rpx 12rpx 0;
  line-height: 1.7;
}
.profile-error {
  font-size: 22rpx;
  line-height: 1.6;
  color: #a46357;
  padding: 12rpx 8rpx;
}
.profile-error button {
  color: #747e55;
  font-size: 24rpx;
}
.profile-mask {
  position: fixed;
  inset: 0;
  background: rgba(49, 51, 42, 0.27);
  z-index: 80;
  display: flex;
  align-items: flex-end;
}
.profile-sheet {
  background: #f8f6ed;
  width: 100%;
  padding: 30rpx 34rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx 38rpx 0 0;
  box-sizing: border-box;
  max-height: calc(100vh - 80px);
  overflow-y: auto;
}
.profile-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
  font-size: 31rpx;
  font-weight: 600;
}
.profile-sheet-head button {
  padding: 10rpx;
  min-width: 44px;
  min-height: 44px;
}
.preference-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 92rpx;
  border-bottom: 1rpx solid #e6e4d7;
  width: 100%;
  text-align: left;
  font-size: 25rpx;
}
.preference-row > text:first-child,
.preference-row > view:first-child {
  flex: 1;
}
.preference-row > view:first-child {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.profile-sheet-muted {
  display: block;
  font-size: 21rpx;
  line-height: 1.6;
  color: #909682;
  margin-top: 14rpx;
}
.preference-row .profile-sheet-muted {
  font-size: 19rpx;
  margin-top: 0;
}
.profile-chart-list {
  height: 44vh;
  max-height: 580rpx;
  min-height: 110rpx;
  margin-top: 22rpx;
}
.profile-chart-row {
  display: flex;
  gap: 18rpx;
  align-items: center;
  margin-bottom: 22rpx;
}
.profile-chart-row > view {
  flex: 1;
}
.profile-chart-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
}
.profile-chart-label > text + text {
  font-size: 21rpx;
  color: #999d8c;
}
.profile-chart-track {
  height: 12rpx;
  background: #e9e7da;
  border-radius: 10rpx;
  overflow: hidden;
  margin-top: 10rpx;
}
.profile-chart-track > view {
  height: 100%;
  background: #c7cd9c;
  border-radius: 10rpx;
}
.profile-chart-empty {
  font-size: 24rpx;
  line-height: 1.8;
  color: #9ba087;
  display: block;
  padding: 28rpx 12rpx;
  text-align: center;
}
@media (max-width: 350px) {
  .profile-page {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }
  .profile-hero {
    gap: 16rpx;
  }
  .profile-avatar {
    width: 162rpx;
    height: 168rpx;
  }
  .profile-name {
    font-size: 28rpx;
  }
  .profile-shortcut {
    padding: 17rpx 19rpx;
  }
  .profile-shortcut > view:first-child > text:first-child {
    font-size: 26rpx;
  }
  .profile-shortcut > view:first-child > text + text {
    font-size: 19rpx;
  }
  .profile-campus-banner > text:nth-child(2) {
    font-size: 24rpx;
  }
  .profile-banner-action {
    padding: 8rpx 14rpx;
  }
}

.profile-stats > view > text + text,
.profile-sync-copy > text + text,
.profile-signature,
.profile-sheet-muted,
.preference-row .profile-sheet-muted,
.profile-chart-label > text + text,
.profile-chart-empty,
.profile-shortcut > view:first-child > text + text {
  color: var(--ui-color-text-secondary);
  font-size: 12px;
}
.profile-stats > view > text:first-child {
  max-width: 100%;
  overflow-wrap: anywhere;
}
.profile-menu-row {
  min-height: 48px;
}
.profile-error button {
  min-height: 44px;
}
.preference-row {
  gap: 12px;
  min-height: 48px;
}
.preference-row > view:first-child {
  min-width: 0;
}
.profile-shortcut:active,
.profile-menu-row:active {
  background: #e3e7d7;
}
