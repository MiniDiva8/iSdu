page {
  background: #f7f5ec;
  background-image: none;
  color: #35412f;
}
button::after {
  border: 0;
}
button {
  background: none;
  padding: 0;
  line-height: 1.5;
  color: inherit;
}
.space-page {
  padding: 32rpx 34rpx 60rpx;
}
.space-eyebrow {
  display: block;
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: #979e87;
}
.space-title {
  display: block;
  font-size: 45rpx;
  font-weight: 600;
  margin: 12rpx 0 15rpx;
}
.space-subtitle {
  font-size: 24rpx;
  color: #929b80;
  line-height: 1.8;
}
.space-identity {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 37rpx 0 28rpx;
  text-align: left;
  width: 100%;
  padding: 27rpx 23rpx;
  border: 1rpx solid #dedfcd;
  border-radius: 25rpx;
  background: #fcfbf1;
}
.space-avatar {
  width: 103rpx;
  height: 103rpx;
  border-radius: 45% 49% 43% 48%;
  background: #d8e2c1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Kaiti SC', 'KaiTi', serif;
  font-size: 45rpx;
  color: #6f8357;
  transform: rotate(-4deg);
}
.space-identity__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 11rpx;
}
.space-name {
  font-size: 32rpx;
  font-weight: 600;
}
.space-signature {
  font-size: 22rpx;
  color: #929b80;
  line-height: 1.8;
}
.space-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  text-align: center;
  padding: 22rpx 0 30rpx;
}
.space-stats > view {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  border-right: 1rpx solid #dadfcb;
}
.space-stats > view:last-child {
  border: 0;
}
.space-stats > view > text:first-child {
  font-size: 38rpx;
  font-family: Georgia, serif;
  color: #5a6e43;
}
.space-stats > view > text:last-child {
  font-size: 21rpx;
  color: #939c81;
}
.space-insight-error {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: #a19e80;
  margin-bottom: 18rpx;
}
.space-menu {
  background: #fcfbf3;
  border: 1rpx solid #dedfce;
  border-radius: 24rpx;
  padding: 0 23rpx;
}
.space-menu > button {
  display: flex;
  align-items: center;
  width: 100%;
  text-align: left;
  gap: 20rpx;
  min-height: 139rpx;
  border-bottom: 1rpx dashed #dfe1cd;
}
.space-menu > button:last-child {
  border: 0;
}
.space-menu > button > view:nth-child(2) {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 7rpx;
}
.space-menu > button > view:nth-child(2) > text:first-child {
  font-size: 27rpx;
}
.space-menu > button > view:nth-child(2) > text:last-child {
  font-size: 20rpx;
  color: #969e84;
  line-height: 1.7;
}
.space-menu-icon {
  width: 67rpx;
  height: 67rpx;
  background: #eae9da;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7f8c6a;
}
.space-menu-icon--yellow {
  background: #efe5bb;
  color: #a28d46;
}
.space-menu-icon--green {
  background: #dfe8cf;
  color: #778d57;
}
.space-menu-icon--blue {
  background: #dce6df;
  color: #7a9685;
}
.space-error {
  display: flex;
  align-items: center;
  gap: 15rpx;
  padding: 20rpx;
  background: #f5e8d9;
  border-radius: 15rpx;
  font-size: 23rpx;
  color: #a18a67;
  margin-top: 22rpx;
}
.space-error button {
  font-size: 23rpx;
  white-space: nowrap;
}
.space-write {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 29rpx;
  background: #ebedda;
  border-radius: 22rpx;
  padding: 26rpx 20rpx;
  text-align: left;
}
.space-write > view {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.space-write > view > text:first-child {
  font-size: 25rpx;
  color: #65794d;
}
.space-write > view > text:last-child {
  font-size: 20rpx;
  color: #9ca689;
}
.space-footer {
  display: block;
  text-align: center;
  color: #a4aa94;
  font-size: 20rpx;
  margin: 35rpx 0 8rpx;
  letter-spacing: 1rpx;
}
