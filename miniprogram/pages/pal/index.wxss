.pal-entry {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 64rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #f7f5ec;
  color: #3e5035;
}
.pal-entry__card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  max-width: 640rpx;
  margin: 0 auto;
  padding: 48rpx 28rpx;
  box-sizing: border-box;
  border: 2rpx solid #fffdf5;
  border-radius: 36rpx;
  background: #fffdf5;
  text-align: center;
}
.pal-entry__eyebrow {
  font-size: 24rpx;
  color: var(--ui-color-text-secondary);
  letter-spacing: 2rpx;
}
.pal-entry__portrait {
  width: 240rpx;
  height: 240rpx;
}
.pal-entry__title {
  font-size: 40rpx;
  font-weight: 600;
}
.pal-entry__description,
.pal-entry__error,
.pal-entry__hint {
  display: block;
  max-width: 100%;
  font-size: 26rpx;
  line-height: 1.7;
  overflow-wrap: break-word;
}
.pal-entry__description,
.pal-entry__hint {
  color: var(--ui-color-text-secondary);
}
.pal-entry__error {
  color: #a44a3b;
}
.pal-entry__button {
  width: 100%;
  min-height: 44px;
  margin: 8rpx 0 0;
  padding: 20rpx 28rpx;
  border-radius: 50rpx;
  background: #667d4c;
  color: #fffdf5;
  font-size: 30rpx;
  line-height: 1.6;
}
.pal-entry__button[disabled] {
  opacity: 0.7;
}
.pal-entry__hint {
  font-size: 12px;
}
