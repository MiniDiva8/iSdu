.invite-card {
  padding: 32px 24px;
  text-align: center;
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-divider);
  border-radius: 20px;
}

.invite-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64px;
  height: 64px;
  margin: 0 auto;
  color: #fff;
  font-size: 24px;
  font-weight: 650;
  background: var(--ui-color-primary);
  border-radius: 50%;
}

.invite-name,
.invite-signature,
.invite-note,
.invite-message {
  display: block;
}

.invite-name {
  margin-top: 16px;
  font-size: 22px;
  font-weight: 650;
}

.invite-signature,
.invite-note {
  margin-top: 8px;
  color: var(--ui-color-text-secondary);
  font-size: 14px;
  line-height: 21px;
}

.invite-action {
  width: 100%;
  min-height: 48px;
  margin-top: 24px;
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  background: var(--ui-color-primary);
  border: 0;
  border-radius: 14px;
}

.invite-action::after {
  border: 0;
}

.invite-message {
  padding: 12px 16px;
  margin-top: 16px;
  color: var(--ui-color-primary-strong);
  font-size: 13px;
  background: var(--ui-color-primary-soft);
  border-radius: 12px;
}
