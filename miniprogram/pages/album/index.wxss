page {
  background: #f7f5ec;
  background-image: none;
  color: #343c30;
}
button::after {
  border: 0;
}
.album-page {
  padding: 42rpx 34rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-image:
    linear-gradient(rgba(157, 161, 132, 0.09) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(157, 161, 132, 0.09) 1rpx, transparent 1rpx);
  background-size: 30rpx 30rpx;
}
.album-eyebrow {
  display: block;
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: #929981;
}
.album-title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  margin: 12rpx 0 26rpx;
}
.album-month {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 30rpx;
  margin-bottom: 24rpx;
  font-size: 27rpx;
}
.album-month button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  background: transparent;
}
.album-hint {
  font-size: 22rpx;
  color: #909880;
  line-height: 1.9;
}
.album-count {
  display: block;
  text-align: center;
  margin-bottom: 28rpx;
}
.album-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 35rpx 24rpx;
}
.polaroid {
  position: relative;
  padding: 15rpx 15rpx 20rpx;
  background: #fffef8;
  border-radius: 2rpx;
  box-shadow: 2rpx 5rpx 15rpx rgba(65, 70, 47, 0.08);
  overflow: visible;
  width: 100%;
  text-align: center;
  line-height: 1.5;
  box-sizing: border-box;
}
.polaroid:nth-child(3n + 1) {
  transform: rotate(-2deg);
}
.polaroid:nth-child(3n + 2) {
  transform: rotate(1.6deg);
}
.polaroid-tape {
  position: absolute;
  top: -12rpx;
  left: 35%;
  width: 30%;
  height: 27rpx;
  z-index: 2;
  background: rgba(180, 199, 157, 0.6);
  transform: rotate(-4deg);
}
.polaroid image,
.polaroid-missing {
  width: 100%;
  height: 270rpx;
  background: #e8ebde;
  display: block;
}
.polaroid-missing {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #89927a;
}
.polaroid-date {
  display: block;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  margin: 16rpx 0 4rpx;
  color: #6f785e;
}
.polaroid-place {
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 23rpx;
  color: #4b573e;
}
.album-state {
  min-height: 400rpx;
  padding: 60rpx 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  gap: 20rpx;
  font-size: 27rpx;
  color: #7b8468;
}
.album-state button {
  font-size: 24rpx;
  background: #e4e9d5;
  padding: 4rpx 30rpx;
  border-radius: 16rpx;
}
.album-empty {
  font-size: 95rpx;
  color: #b6bea3;
}
