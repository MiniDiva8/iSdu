@import '../../../styles/companion.wxss';
.task-playground-entry {
  background: #edf1df;
  gap: 18rpx;
}
.task-playground-entry > view {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.task-playground-entry button {
  align-self: flex-start;
}
.checkin-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 13rpx;
}
.checkin-day {
  margin: 0;
  padding: 18rpx 5rpx;
  border: 2rpx solid #e4e9d9;
  border-radius: 22rpx;
  background: #f0f2e7;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: center;
  font-size: 20rpx;
  line-height: 1.5;
  color: #79856a;
}
.checkin-day--today {
  background: #e6edce;
  border-color: #94ac70;
}
.checkin-day--done {
  background: #eef1e4;
  color: #7e8b6d;
}
.checkin-day__star {
  font-size: 40rpx;
  color: #8b9d67;
}
.checkin-day__makeup {
  font-size: 18rpx;
  color: #9e9879;
}
.task-card {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  gap: 20rpx;
}
.task-card > view {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}
.task-card__title {
  font-size: 28rpx;
  font-weight: 500;
}
.task-card button {
  font-size: 23rpx;
  padding: 15rpx 20rpx;
  flex-shrink: 0;
}
.task-card__reward {
  font-size: 23rpx;
  color: #a3985a;
}
.task-card__claimed {
  font-size: 24rpx;
  color: #93a07f;
}

.task-claim-summary {
  margin-top: 20rpx;
  gap: 18rpx;
}
.task-claim-summary > view {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.task-claim-summary button {
  width: 100%;
  box-sizing: border-box;
}
