page {
  height: 100%;
  overflow: hidden;
  background: #c8dac0;
}
.playground-page {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #c8dac0;
  color: #3f4240;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}
.playground-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
.playground-page button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  line-height: 1.4;
  border: 0;
}
.playground-page button::after {
  border: 0;
}
.playground-back {
  position: absolute;
  left: 14px;
  z-index: 7;
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff8e65e;
  color: #4f624f;
}
.playground-bottom {
  position: absolute;
  left: 18px;
  right: 20px;
  bottom: calc(22px + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  pointer-events: none;
  z-index: 7;
}
.playground-more {
  width: 35px;
  height: 35px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff8e652;
  color: #5b6d52;
  pointer-events: auto;
  flex-shrink: 0;
}
.playground-hint {
  font-size: 12px;
  line-height: 1.5;
  letter-spacing: 1px;
  color: #607b586e;
  text-align: center;
  max-width: 250px;
  position: absolute;
  left: 36px;
  right: 36px;
  bottom: 8px;
}
.playground-again {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff5da;
  color: #493e39;
  box-shadow: inset 0 0 0 2px #423936;
  pointer-events: auto;
  flex-shrink: 0;
}
.playground-note {
  position: absolute;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6px;
  box-sizing: border-box;
  padding: 14px 12px 10px;
  background: linear-gradient(150deg, #fff5ae, #ffe487);
  color: #433b31;
  text-align: center;
  font-family: 'STKaiti', 'KaiTi', 'Microsoft YaHei', serif;
  box-shadow: 1px 5px 8px #51402938;
  border-radius: 2px 3px 12px 3px;
  transform: rotate(-3deg);
  animation: paper-turn 0.23s 0.23s both cubic-bezier(0.23, 0.8, 0.32, 1);
}
.playground-note::after {
  content: '';
  position: absolute;
  right: 0;
  bottom: 0;
  border: 6px solid transparent;
  border-top-color: #e8c55d;
  border-left-color: #e8c55d;
}
.playground-note__tape {
  position: absolute;
  left: calc(50% - 20px);
  top: -5px;
  width: 40px;
  height: 12px;
  background: #ead2a4d9;
  transform: rotate(5deg);
}
.playground-note__close {
  position: absolute;
  right: 2px;
  top: 1px;
  width: 25px;
  height: 25px;
  background: transparent;
  color: #897745;
  font-size: 18px;
}
.playground-note__from {
  font-size: 11px;
  line-height: 14px;
  color: #9b8248;
}
.playground-note__title {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 16px;
  line-height: 1.25;
  font-weight: 600;
  max-width: 100%;
}
.playground-note__hint {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 13px;
  line-height: 1.4;
  color: #7e6a40;
  max-width: 100%;
}
.playground-note__action {
  background: #f5cf65;
  color: #5c4c31;
  border-radius: 4px;
  font-size: 12px;
  padding: 6px 11px !important;
  max-width: 100%;
}
.playground-note__action[disabled] {
  background: #f3d885;
  color: #968355;
}
.playground-note__message {
  font-size: 10px;
  line-height: 1.3;
  max-height: 26px;
  overflow: hidden;
  color: #9c793c;
}
.playground-countdown {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-size: 10px;
  line-height: 1.4;
  color: #927b42;
}
.playground-countdown button {
  font-size: 11px;
  background: transparent;
  color: #5e7650;
  text-decoration: underline;
  padding: 3px !important;
}
@keyframes paper-turn {
  from {
    transform: perspective(600px) rotateY(-90deg) rotate(-3deg);
    opacity: 0;
  }
  to {
    transform: perspective(600px) rotateY(0) rotate(-3deg);
    opacity: 1;
  }
}
.playground-confetti {
  position: absolute;
  inset: 0;
  z-index: 6;
  pointer-events: none;
  overflow: hidden;
}
.confetti-bit {
  position: absolute;
  top: -30px;
  width: 10px;
  height: 16px;
  border-radius: 3px;
  animation: confetti-right 2.7s linear infinite;
}
.confetti-bit:nth-child(2n) {
  animation-name: confetti-left;
}
@keyframes confetti-right {
  to {
    transform: translate(70px, 110vh) rotate(440deg);
  }
}
@keyframes confetti-left {
  to {
    transform: translate(-90px, 110vh) rotate(-360deg);
  }
}
.playground-menu {
  position: absolute;
  left: 18px;
  bottom: calc(70px + env(safe-area-inset-bottom));
  z-index: 9;
  background: #fff9eaef;
  box-shadow: 0 6px 25px #526a4326;
  border: 1px solid #d6d8bb;
  border-radius: 12px;
  padding: 10px 12px;
  min-width: 166px;
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.playground-menu > text {
  font-size: 10px;
  color: #9b9c7d;
  margin: 3px 0 8px;
}
.playground-menu button {
  background: transparent;
  color: #596c4a;
  font-size: 13px;
  text-align: left;
  padding: 9px 4px;
}
.playground-list-panel {
  position: absolute;
  left: 14px;
  right: 14px;
  bottom: calc(72px + env(safe-area-inset-bottom));
  max-height: 65%;
  background: #fcf8eaef;
  border: 1px solid #d9ddc3;
  border-radius: 14px;
  padding: 14px;
  z-index: 9;
  box-shadow: 0 8px 30px #5765472b;
}
.playground-list-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #697b57;
  font-size: 13px;
  margin-bottom: 8px;
}
.playground-list-heading button {
  font-size: 22px;
  color: #9a9c77;
  background: transparent;
  width: 30px;
  height: 30px;
}
.playground-partners {
  display: block;
  height: 290px;
  max-height: 44vh;
  overflow: auto;
}
.playground-partners button {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  background: transparent;
  padding: 6px 2px !important;
  color: #586b4c;
  text-align: left;
  font-size: 13px;
}
.playground-partners image {
  width: 42px;
  height: 42px;
  flex-shrink: 0;
}
.partner-action {
  margin-left: auto;
  font-size: 11px;
  color: #9aa17c;
}
.playground-dialog {
  position: absolute;
  left: 50%;
  top: 48%;
  transform: translate(-50%, -50%);
  width: calc(100% - 44px);
  max-width: 300px;
  box-sizing: border-box;
  padding: 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15px;
  background: #fff9eaef;
  border: 1px solid #d8d9bc;
  border-radius: 12px;
  color: #6b7756;
  text-align: center;
  font-size: 13px;
  line-height: 1.7;
  z-index: 8;
}
.playground-dialog image {
  width: 110px;
  height: 110px;
}
.dialog-title {
  font-size: 19px;
  font-weight: 600;
}
.playground-dialog button {
  background: #e9e8ca;
  color: #61754f;
  padding: 8px 17px !important;
  border-radius: 6px;
  font-size: 13px;
}
.playground-status {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 80px;
  text-align: center;
  color: #788d65;
  font-size: 12px;
}
.is-paused .confetti-bit {
  animation-play-state: paused;
}
@media (prefers-reduced-motion: reduce) {
  .playground-note {
    animation: none;
  }
  .confetti-bit {
    animation: none;
    top: 30%;
    opacity: 0.5;
  }
}
.playground-toast {
  position: absolute;
  left: 60px;
  right: 18px;
  bottom: calc(72px + env(safe-area-inset-bottom));
  padding: 9px 12px;
  border-radius: 8px;
  background: #fff7daee;
  color: #7f724c;
  max-height: 54px;
  overflow: hidden;
  line-height: 1.5;
  font-size: 12px;
  z-index: 8;
}
