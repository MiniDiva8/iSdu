page {
  background: #f7f5ec;
  background-image: none;
  color: #303831;
}
button::after {
  border: 0;
}
button {
  margin: 0;
  padding: 0;
  line-height: 1;
  background: none;
  font-weight: 400;
  color: inherit;
  border-radius: 0;
}
.journal-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 38rpx 140rpx;
  background-color: #f7f5ec;
  background-image: radial-gradient(#cecdbb 0.8px, transparent 0.8px);
  background-size: 24rpx 24rpx;
}
.journal-brand {
  position: absolute;
  z-index: 1;
  left: 40rpx;
  height: 44px;
  display: flex;
  gap: 14rpx;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.journal-brand__mark {
  background: #ead8a3;
  width: 35rpx;
  height: 35rpx;
  border-radius: 11rpx;
  text-align: center;
  line-height: 35rpx;
  font-family: Georgia, serif;
  font-weight: 700;
  font-size: 30rpx;
}
.journal-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}
.journal-toolbar__left,
.journal-toolbar__right {
  display: flex;
  gap: 12rpx;
}
.journal-icon {
  display: flex;
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
}
.journal-month {
  text-align: center;
  margin: 10rpx 0 34rpx;
}
.journal-year {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #737a6c;
}
.journal-month__row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 10rpx 0 17rpx;
}
.journal-month__name {
  font-family: 'Kaiti SC', 'KaiTi', serif;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.3;
  padding: 0 12rpx;
  background: linear-gradient(transparent 66%, #e9d99c 66%, #e9d99c 94%, transparent 94%);
}
.month-arrow {
  height: 44px;
  width: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #687260;
}
.journal-subtitle {
  font-size: 22rpx;
  color: #7f8373;
  letter-spacing: 1rpx;
}
.mood-wall {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  column-gap: 12rpx;
  row-gap: 22rpx;
}
.mood-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: visible;
  min-width: 0;
}
/* Override the native disabled-button surface while dates wait for data. */
button.mood-day[disabled] {
  background: transparent;
  color: inherit;
}
.mood-day__face {
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.mood-day__empty {
  width: 84rpx;
  height: 84rpx;
  border-radius: 49% 45% 51% 46%;
  border: 2rpx dashed #c5c8b8;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9caa84;
  background: rgba(255, 255, 250, 0.35);
  font-size: 43rpx;
}
.mood-day__seed {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #c8cbbc;
}
.mood-day__date {
  font-size: 20rpx;
  line-height: 1.6;
  color: #8b8f7e;
  margin-top: 4rpx;
}
.mood-day--today .mood-day__date {
  background: #ebdcaa;
  border-radius: 6rpx;
  color: #4c583d;
  padding: 0 10rpx;
}
.mood-day--today .mood-day__empty {
  border-style: solid;
  border-color: #acb77d;
  background: #eff0db;
}
.mood-day--future {
  opacity: 0.35;
}
.mood-day__count {
  position: absolute;
  right: 0;
  top: 0;
  min-width: 29rpx;
  height: 29rpx;
  line-height: 29rpx;
  background: #fffdf7;
  border: 1rpx solid #d1d6bf;
  border-radius: 50%;
  font-size: 17rpx;
  color: #59634d;
}
.mood-day__demo {
  font-size: 17rpx;
}
.journal-bottom {
  margin-top: 38rpx;
}
.journal-bottom__note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  font-size: 20rpx;
  color: #979a88;
  letter-spacing: 1rpx;
}
.journal-line {
  width: 32rpx;
  height: 1rpx;
  background: #c8cbb9;
}
.journal-footer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  font-size: 18rpx;
  color: #929884;
}
.journal-footer-row button {
  font-size: 20rpx;
  line-height: 40rpx;
}
.journal-compose {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 41% 49% 43% 48%;
  background: #ead695;
  box-shadow: 0 9rpx 25rpx rgba(103, 89, 50, 0.12);
  z-index: 8;
  transform: rotate(-4deg);
}
.journal-draft {
  font-size: 22rpx;
  line-height: 2;
  color: #697549;
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.journal-search {
  background: #fffdf5;
  border: 1rpx solid #e0dfd0;
  border-radius: 19rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}
.journal-search input {
  font-size: 25rpx;
  height: 48rpx;
}
.search-entry {
  display: flex;
  align-items: center;
  gap: 15rpx;
  padding: 20rpx 0;
  text-align: left;
  border-top: 1rpx dashed #e4e4d7;
}
.search-entry text {
  font-size: 24rpx;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.journal-muted {
  font-size: 22rpx;
  color: #898e7b;
  display: block;
  padding: 15rpx 0;
}
.search-results {
  margin-top: 13rpx;
}
.journal-loading {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 30rpx 18rpx;
  padding: 10rpx 4rpx;
}
.journal-skeleton {
  height: 94rpx;
  border-radius: 47%;
  background: #e7e7d9;
  opacity: 0.7;
}
.journal-state {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: center;
  text-align: center;
  padding: 65rpx 24rpx;
  font-size: 24rpx;
  color: #7a826a;
}
.journal-state__symbol {
  font-size: 70rpx;
  color: #a5b09b;
}
.journal-state__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #404a36;
}
.journal-soft-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  line-height: 1.5;
  border-radius: 18rpx;
  background: #e9edda;
  font-size: 25rpx;
  margin-top: 20rpx;
  padding: 0 28rpx;
  color: #48563b;
}
.journal-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(36, 40, 31, 0.32);
  display: flex;
  align-items: flex-end;
}
.journal-sheet {
  width: 100%;
  box-sizing: border-box;
  max-height: calc(100vh - 80px);
  overflow-y: auto;
  padding: 34rpx 38rpx calc(38rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx 38rpx 0 0;
  background: #faf8ef;
  box-shadow: 0 -16rpx 60rpx rgba(45, 51, 36, 0.08);
}
.sheet-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.sheet-heading > view {
  display: flex;
  flex-direction: column;
  gap: 9rpx;
}
.sheet-heading button {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet-date {
  font-size: 22rpx;
  color: #8a8e7b;
  letter-spacing: 2rpx;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
}
.mood-picker-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 28rpx 12rpx;
}
.mood-choice {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 11rpx;
  font-size: 22rpx;
  color: #6d755f;
  padding: 8rpx 0;
}
.sheet-footnote {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #969d86;
  margin-top: 30rpx;
}
.day-sheet-list {
  max-height: 56vh;
}
.day-entry {
  display: flex;
  align-items: center;
  text-align: left;
  gap: 24rpx;
  padding: 24rpx 2rpx;
  border-bottom: 1rpx dashed #dfdfcd;
}
.day-entry__copy {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.day-entry__copy > text:first-child {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.day-entry__place {
  font-size: 20rpx;
  color: #939982;
}

.journal-companion {
  display: flex;
  align-items: center;
  gap: 22rpx;
  width: 100%;
  margin: 32rpx 0 0;
  padding: 24rpx;
  background: #edf0e0;
  border: 1rpx solid #dce2cc;
  border-radius: 28rpx;
  text-align: left;
  color: #697d50;
  line-height: 1.7;
}
.journal-companion image,
.journal-companion__placeholder {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
}
.journal-companion__placeholder {
  border-radius: 50%;
  background: #dfe6cf;
  display: flex;
  align-items: center;
  justify-content: center;
}
.journal-companion > view:not(.journal-companion__placeholder) {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}
.journal-companion text {
  font-size: 27rpx;
}
.journal-companion text + text {
  font-size: 22rpx;
  color: #8c987a;
}

.journal-companion__sprite {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  background-repeat: no-repeat;
}

.journal-refresh-status {
  display: block;
  padding: 12rpx 0;
  text-align: center;
}

.journal-footer-row {
  gap: 8px;
  flex-wrap: wrap;
}
.journal-footer-row > text {
  flex: 1;
  min-width: 110px;
  text-align: center;
  line-height: 1.6;
}
.journal-footer-row button,
.journal-draft,
.journal-soft-button {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.journal-subtitle,
.journal-muted,
.mood-day__date,
.journal-footer-row,
.journal-footer-row button,
.journal-bottom__note,
.day-entry__place,
.sheet-date,
.journal-companion text + text {
  color: var(--ui-color-text-secondary);
  font-size: 12px;
}
.journal-search input {
  height: 44px;
}
.journal-icon:active,
.month-arrow:active,
.sheet-heading button:active {
  border-radius: 14px;
  background: var(--ui-color-primary-soft);
}

.journal-background-image {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100vh;
  z-index: 0;
  pointer-events: none;
}
.journal-foreground {
  position: relative;
  z-index: 1;
}
.journal-page--custom {
  background-image: none;
}
.journal-page--custom .journal-brand {
  background: rgba(250, 248, 239, 0.86);
  border-radius: 12px;
  padding: 0 12px;
  left: 24rpx;
}
.journal-page--custom .journal-icon,
.journal-page--custom .month-arrow,
.journal-page--custom .journal-background-entry,
.journal-page--custom .journal-footer-row button {
  background: rgba(250, 248, 239, 0.86);
  border-radius: 16px;
  color: #35442e;
}
.journal-page--custom .journal-year,
.journal-page--custom .journal-subtitle,
.journal-page--custom .journal-month__name,
.journal-page--custom .journal-bottom__note,
.journal-page--custom .journal-draft,
.journal-page--custom .journal-refresh-status,
.journal-page--custom .journal-footer-row > text {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(250, 248, 239, 0.86);
  color: #35442e;
}
.journal-page--custom .journal-month__name {
  padding: 4rpx 20rpx;
}
.journal-page--custom .mood-day__empty {
  border-color: #eef1df;
  background: rgba(255, 255, 250, 0.22);
  box-shadow: 0 0 0 1rpx rgba(39, 52, 35, 0.25);
}
.journal-page--custom .mood-day__seed {
  background: #f8f8ef;
  box-shadow: 0 0 0 1rpx rgba(39, 52, 35, 0.25);
}
.journal-page--custom .mood-day__date {
  min-width: 30rpx;
  padding: 0 10rpx;
  border-radius: 12rpx;
  background: rgba(250, 248, 239, 0.86);
  color: #35442e;
}
.journal-page--custom .mood-day--today .mood-day__date {
  background: #ebdcaa;
}
.journal-page--custom .mood-day--future {
  opacity: 1;
}
.journal-page--custom .mood-day--future .mood-day__empty {
  background: rgba(255, 255, 250, 0.1);
  border-color: rgba(238, 241, 223, 0.55);
}
.journal-page--custom .mood-day--future .mood-day__seed {
  opacity: 0.55;
}
.journal-page--custom .journal-bottom {
  text-align: center;
}
.journal-page--custom .journal-bottom__note,
.journal-page--custom .journal-draft {
  display: inline-flex;
}
.journal-background-entry-row {
  display: flex;
  justify-content: center;
  margin: 10rpx 0 -12rpx;
}
.journal-background-entry {
  display: flex;
  gap: 6px;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 0 16px;
  border-radius: 22px;
  color: #5b694a;
  font-size: 12px;
}
.journal-background-entry:active {
  background: #e9edda;
}
.journal-background-entry__dot {
  color: #8a573f;
  font-size: 24px;
}
.background-sheet .sheet-heading {
  gap: 10px;
}
.background-sheet .sheet-heading > view {
  min-width: 0;
  flex: 1;
}
.background-sheet .sheet-heading button {
  flex-shrink: 0;
}
.background-sheet .sheet-title {
  font-size: 20px;
  line-height: 1.5;
}
.background-help,
.background-error {
  display: block;
  font-size: 12px;
  line-height: 1.8;
  color: #5b6654;
}
.background-error {
  margin-top: 14px;
  color: #8a4835;
}
.background-primary {
  gap: 10px;
  width: 100%;
  font-size: 14px;
}
.background-pending {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  margin-top: 16px;
  background: #f0efdf;
  border-radius: 12px;
}
.background-pending image {
  width: 54px;
  height: 54px;
  border-radius: 8px;
  flex-shrink: 0;
}
.background-pending > view {
  display: flex;
  flex-direction: column;
  gap: 5px;
  min-width: 0;
  font-size: 13px;
  line-height: 1.6;
}
.background-pending text + text {
  font-size: 12px;
  color: #626d55;
}
.background-retry,
.background-reset {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  margin-top: 12px;
  width: 100%;
  line-height: 1.5;
  font-size: 13px;
  color: #5b694a;
  border-radius: 12px;
}
.background-reset {
  border: 1px solid #d9ddca;
}
.background-clarity {
  margin-top: 24px;
}
.background-clarity__heading,
.background-clarity__ends {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
}
.background-clarity slider {
  margin: 18px 0 10px;
}
.background-clarity__ends {
  color: #626d55;
  font-size: 12px;
}
.background-sheet button[disabled] {
  color: #727865;
}
