page {
  background: #f7f5ec;
  background-image: none;
  color: #303831;
}
button::after {
  border: 0;
}
button {
  margin: 0;
  padding: 0;
  line-height: 1;
  background: none;
  font-weight: 400;
  color: inherit;
  border-radius: 0;
}
.journal-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 38rpx 140rpx;
  background-color: #f7f5ec;
  background-image: radial-gradient(#cecdbb 0.8px, transparent 0.8px);
  background-size: 24rpx 24rpx;
}
.journal-brand {
  position: absolute;
  left: 40rpx;
  height: 44px;
  display: flex;
  gap: 14rpx;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.journal-brand__mark {
  background: #ead8a3;
  width: 35rpx;
  height: 35rpx;
  border-radius: 11rpx;
  text-align: center;
  line-height: 35rpx;
  font-family: Georgia, serif;
  font-weight: 700;
  font-size: 30rpx;
}
.journal-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}
.journal-toolbar__left,
.journal-toolbar__right {
  display: flex;
  gap: 26rpx;
}
.journal-icon {
  display: flex;
  width: 58rpx;
  height: 62rpx;
  align-items: center;
  justify-content: center;
}
.journal-month {
  text-align: center;
  margin: 10rpx 0 34rpx;
}
.journal-year {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: #737a6c;
}
.journal-month__row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin: 10rpx 0 17rpx;
}
.journal-month__name {
  font-family: 'Kaiti SC', 'KaiTi', serif;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.3;
  padding: 0 12rpx;
  background: linear-gradient(transparent 66%, #e9d99c 66%, #e9d99c 94%, transparent 94%);
}
.month-arrow {
  height: 62rpx;
  width: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #687260;
}
.journal-subtitle {
  font-size: 22rpx;
  color: #7f8373;
  letter-spacing: 1rpx;
}
.mood-wall {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  column-gap: 12rpx;
  row-gap: 22rpx;
}
.mood-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: visible;
  min-width: 0;
}
.mood-day__face {
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.mood-day__empty {
  width: 84rpx;
  height: 84rpx;
  border-radius: 49% 45% 51% 46%;
  border: 2rpx dashed #c5c8b8;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9caa84;
  background: rgba(255, 255, 250, 0.35);
  font-size: 43rpx;
}
.mood-day__seed {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #c8cbbc;
}
.mood-day__date {
  font-size: 20rpx;
  line-height: 1.6;
  color: #8b8f7e;
  margin-top: 4rpx;
}
.mood-day--today .mood-day__date {
  background: #ebdcaa;
  border-radius: 6rpx;
  color: #4c583d;
  padding: 0 10rpx;
}
.mood-day--today .mood-day__empty {
  border-style: solid;
  border-color: #acb77d;
  background: #eff0db;
}
.mood-day--future {
  opacity: 0.35;
}
.mood-day__count {
  position: absolute;
  right: 0;
  top: 0;
  min-width: 29rpx;
  height: 29rpx;
  line-height: 29rpx;
  background: #fffdf7;
  border: 1rpx solid #d1d6bf;
  border-radius: 50%;
  font-size: 17rpx;
  color: #59634d;
}
.mood-day__demo {
  font-size: 17rpx;
}
.journal-bottom {
  margin-top: 38rpx;
}
.journal-bottom__note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  font-size: 20rpx;
  color: #979a88;
  letter-spacing: 1rpx;
}
.journal-line {
  width: 32rpx;
  height: 1rpx;
  background: #c8cbb9;
}
.journal-footer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  font-size: 18rpx;
  color: #929884;
}
.journal-footer-row button {
  font-size: 20rpx;
  line-height: 40rpx;
}
.journal-compose {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 41% 49% 43% 48%;
  background: #ead695;
  box-shadow: 0 9rpx 25rpx rgba(103, 89, 50, 0.12);
  z-index: 8;
  transform: rotate(-4deg);
}
.journal-draft {
  font-size: 22rpx;
  line-height: 2;
  color: #697549;
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.journal-search {
  background: #fffdf5;
  border: 1rpx solid #e0dfd0;
  border-radius: 19rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}
.journal-search input {
  font-size: 25rpx;
  height: 48rpx;
}
.search-entry {
  display: flex;
  align-items: center;
  gap: 15rpx;
  padding: 20rpx 0;
  text-align: left;
  border-top: 1rpx dashed #e4e4d7;
}
.search-entry text {
  font-size: 24rpx;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.journal-muted {
  font-size: 22rpx;
  color: #898e7b;
  display: block;
  padding: 15rpx 0;
}
.search-results {
  margin-top: 13rpx;
}
.journal-loading {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 30rpx 18rpx;
  padding: 10rpx 4rpx;
}
.journal-skeleton {
  height: 94rpx;
  border-radius: 47%;
  background: #e7e7d9;
  opacity: 0.7;
}
.journal-state {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: center;
  text-align: center;
  padding: 65rpx 24rpx;
  font-size: 24rpx;
  color: #7a826a;
}
.journal-state__symbol {
  font-size: 70rpx;
  color: #a5b09b;
}
.journal-state__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #404a36;
}
.journal-soft-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  line-height: 1.5;
  border-radius: 18rpx;
  background: #e9edda;
  font-size: 25rpx;
  margin-top: 20rpx;
  padding: 0 28rpx;
  color: #48563b;
}
.journal-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(36, 40, 31, 0.32);
  display: flex;
  align-items: flex-end;
}
.journal-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 34rpx 38rpx calc(38rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx 38rpx 0 0;
  background: #faf8ef;
  box-shadow: 0 -16rpx 60rpx rgba(45, 51, 36, 0.08);
}
.sheet-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.sheet-heading > view {
  display: flex;
  flex-direction: column;
  gap: 9rpx;
}
.sheet-heading button {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sheet-date {
  font-size: 22rpx;
  color: #8a8e7b;
  letter-spacing: 2rpx;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 600;
}
.mood-picker-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 28rpx 12rpx;
}
.mood-choice {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 11rpx;
  font-size: 22rpx;
  color: #6d755f;
  padding: 8rpx 0;
}
.sheet-footnote {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #969d86;
  margin-top: 30rpx;
}
.day-sheet-list {
  max-height: 56vh;
}
.day-entry {
  display: flex;
  align-items: center;
  text-align: left;
  gap: 24rpx;
  padding: 24rpx 2rpx;
  border-bottom: 1rpx dashed #dfdfcd;
}
.day-entry__copy {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.day-entry__copy > text:first-child {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.day-entry__place {
  font-size: 20rpx;
  color: #939982;
}
