:host {
  display: inline-flex;
  vertical-align: middle;
}
.motion-avatar {
  position: relative;
  display: block;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  overflow: hidden;
  border-radius: 50%;
  line-height: 1;
  box-sizing: border-box;
  color: #42443d;
}
.motion-avatar::after {
  border: 0;
}
.motion-avatar-ring {
  z-index: 2;
  position: absolute;
  inset: 4rpx;
  border: 4rpx solid #42443d;
  border-radius: 47% 51% 46% 45%/48% 53% 45% 47%;
  transform: rotate(-4deg);
  pointer-events: none;
}
.motion-avatar-ball {
  overflow: hidden;
  border-radius: 50%;
  position: absolute;
  left: 50%;
  top: 50%;
  will-change: transform;
  pointer-events: none;
  opacity: 0.42;
  filter: grayscale(0.82);
}
.motion-avatar-face {
  width: 94rpx;
  height: 94rpx;
  transform-origin: left top;
}
.motion-avatar-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  opacity: 0.42;
  filter: grayscale(0.82);
}
.motion-avatar-canvas--hidden,
.motion-avatar-ball--hidden {
  visibility: hidden;
}
.motion-avatar-initial {
  position: absolute;
  top: 21rpx;
  right: 22rpx;
  font-size: 34rpx;
  font-family: 'Kaiti SC', 'KaiTi', serif;
  color: #747769;
  opacity: 0.65;
  pointer-events: none;
}
