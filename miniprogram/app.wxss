page {
  /* Warm Editorial Campus design tokens */
  --ui-color-background: #f6f2ea;
  --ui-color-background-alt: #f8f5ef;
  --ui-color-surface: #fffdf9;
  --ui-color-surface-secondary: #f1ece3;
  --ui-color-primary: #437a64;
  --ui-color-primary-pressed: #386b56;
  --ui-color-primary-strong: #315e4d;
  --ui-color-primary-soft: #e6f0ea;
  --ui-color-text-primary: #222620;
  --ui-color-text-secondary: #6d726b;
  --ui-color-text-tertiary: #979c95;
  --ui-color-disabled: #b7bbb5;
  --ui-color-divider: rgba(34, 38, 32, 0.08);
  --ui-color-danger: #c65a55;
  --ui-color-danger-soft: #f8e9e7;
  --ui-color-mood-soft: #f5ead8;
  --ui-space-1: 4px;
  --ui-space-2: 8px;
  --ui-space-3: 12px;
  --ui-space-4: 16px;
  --ui-space-5: 20px;
  --ui-space-6: 24px;
  --ui-space-7: 32px;
  --ui-space-8: 40px;
  --ui-radius-small: 12px;
  --ui-radius-medium: 16px;
  --ui-radius-large: 20px;
  --ui-radius-pill: 999px;
  --ui-shadow-floating: 0 8px 24px rgba(35, 45, 38, 0.06);
  --ui-page-max-width: 720px;
  --ui-map-max-width: 960px;
  --ui-safe-area-bottom: env(safe-area-inset-bottom);

  /* Compatibility aliases for existing page code and TDesign. */
  --sdu-color-background: var(--ui-color-background);
  --sdu-color-paper: var(--ui-color-surface);
  --sdu-color-text-primary: var(--ui-color-text-primary);
  --sdu-color-text-secondary: var(--ui-color-text-secondary);
  --sdu-color-accent: var(--ui-color-primary);
  --sdu-color-accent-soft: var(--ui-color-primary-soft);
  --sdu-card-radius: var(--ui-radius-large);
  --sdu-page-spacing: var(--ui-space-5);
  --sdu-safe-area-bottom: var(--ui-safe-area-bottom);
  --td-brand-color: var(--ui-color-primary);
  --td-brand-color-active: var(--ui-color-primary-pressed);
  --td-brand-color-disabled: #a6c1b5;
  --td-radius-default: var(--ui-radius-small);

  min-height: 100%;
  color: var(--ui-color-text-primary);
  background: var(--ui-color-background);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
}

.page-shell {
  box-sizing: border-box;
  width: 100%;
  max-width: var(--ui-page-max-width);
  min-height: 100vh;
  padding: var(--ui-space-5);
  padding-bottom: calc(var(--ui-space-7) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--ui-space-7) + var(--ui-safe-area-bottom));
  margin: 0 auto;
}

.page-hero {
  padding: var(--ui-space-2) 0 var(--ui-space-6);
}

.eyebrow {
  display: block;
  margin-bottom: var(--ui-space-2);
  color: var(--ui-color-primary);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.06em;
  line-height: 18px;
}

.page-title {
  display: block;
  color: var(--ui-color-text-primary);
  font-size: 28px;
  font-weight: 600;
  line-height: 34px;
}

.page-subtitle {
  display: block;
  max-width: 560px;
  margin-top: var(--ui-space-2);
  color: var(--ui-color-text-secondary);
  font-size: 15px;
  font-weight: 400;
  line-height: 23px;
}

.section-title {
  display: block;
  color: var(--ui-color-text-primary);
  font-size: 20px;
  font-weight: 600;
  line-height: 28px;
}

.supporting-copy {
  display: block;
  color: var(--ui-color-text-secondary);
  font-size: 14px;
  line-height: 20px;
}

.paper-card,
.ui-surface {
  box-sizing: border-box;
  padding: var(--ui-space-5);
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-divider);
  border-radius: var(--ui-radius-large);
}

.paper-card + .paper-card {
  margin-top: var(--ui-space-4);
}

.ui-chip {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 28px;
  padding: 4px 10px;
  color: var(--ui-color-primary-strong);
  font-size: 13px;
  font-weight: 500;
  line-height: 18px;
  background: var(--ui-color-primary-soft);
  border-radius: var(--ui-radius-pill);
}

.ui-chip--mood {
  color: #775431;
  background: var(--ui-color-mood-soft);
}

.ui-text-button {
  box-sizing: border-box;
  min-width: 44px;
  min-height: 44px;
  padding: 0 var(--ui-space-2);
  margin: 0;
  color: var(--ui-color-primary);
  font-size: 14px;
  font-weight: 500;
  line-height: 44px;
  background: transparent;
  border: 0;
  border-radius: var(--ui-radius-small);
}

.ui-text-button::after {
  border: 0;
}

.ui-text-button[disabled] {
  color: var(--ui-color-disabled);
  background: transparent;
}

.ui-divider {
  height: 1px;
  background: var(--ui-color-divider);
}

.ui-state {
  display: flex;
  min-height: 280px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: var(--ui-space-7) var(--ui-space-5);
  text-align: center;
}

.ui-state__title {
  margin-top: var(--ui-space-4);
  font-size: 18px;
  font-weight: 600;
  line-height: 24px;
}

.ui-state__copy {
  max-width: 360px;
  margin-top: var(--ui-space-2);
  color: var(--ui-color-text-secondary);
  font-size: 14px;
  line-height: 20px;
}

.component-space {
  margin-top: var(--ui-space-5);
}

.button-stack {
  display: flex;
  flex-direction: column;
  gap: var(--ui-space-3);
  margin-top: var(--ui-space-5);
}

@media (max-width: 340px) {
  .page-shell {
    padding-right: var(--ui-space-4);
    padding-left: var(--ui-space-4);
  }

  .page-title {
    font-size: 26px;
    line-height: 32px;
  }
}
