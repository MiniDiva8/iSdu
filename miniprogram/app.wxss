page {
  /* Mist & Ink: cool jade, porcelain surfaces and restrained brass accents. */
  --ui-color-background: #edf3f1;
  --ui-color-background-alt: #f3f7f5;
  --ui-color-surface: #fcfdfb;
  --ui-color-surface-secondary: #e7eeeb;
  --ui-color-primary: #245d59;
  --ui-color-primary-pressed: #194844;
  --ui-color-primary-strong: #1b4542;
  --ui-color-primary-soft: #deebe6;
  --ui-color-accent: #947449;
  --ui-color-accent-soft: #f1ebe0;
  --ui-color-text-primary: #203b38;
  --ui-color-text-secondary: #526b66;
  --ui-color-text-tertiary: #697d77;
  --ui-color-disabled: #b7bbb5;
  --ui-color-divider: rgba(36, 93, 89, 0.12);
  --ui-color-danger: #c65a55;
  --ui-color-danger-soft: #f8e9e7;
  --ui-color-mood-soft: #f5ead8;
  --ui-space-1: 4px;
  --ui-space-2: 8px;
  --ui-space-3: 12px;
  --ui-space-4: 16px;
  --ui-space-5: 20px;
  --ui-space-6: 24px;
  --ui-space-7: 32px;
  --ui-space-8: 40px;
  --ui-radius-small: 12px;
  --ui-radius-medium: 16px;
  --ui-radius-large: 20px;
  --ui-radius-pill: 999px;
  --ui-shadow-soft: 0 4px 16px rgba(27, 69, 66, 0.05);
  --ui-shadow-floating: 0 12px 32px rgba(27, 69, 66, 0.1);
  --ui-font-display: 'Kaiti SC', 'STKaiti', 'KaiTi', 'Songti SC', 'STSong', 'SimSun', serif;
  --ui-page-max-width: 720px;
  --ui-map-max-width: 960px;
  --ui-safe-area-bottom: env(safe-area-inset-bottom);

  /* Compatibility aliases for existing page code and TDesign. */
  --sdu-color-background: var(--ui-color-background);
  --sdu-color-paper: var(--ui-color-surface);
  --sdu-color-text-primary: var(--ui-color-text-primary);
  --sdu-color-text-secondary: var(--ui-color-text-secondary);
  --sdu-color-accent: var(--ui-color-primary);
  --sdu-color-accent-soft: var(--ui-color-primary-soft);
  --sdu-card-radius: var(--ui-radius-large);
  --sdu-page-spacing: var(--ui-space-5);
  --sdu-safe-area-bottom: var(--ui-safe-area-bottom);
  --td-brand-color: var(--ui-color-primary);
  --td-brand-color-active: var(--ui-color-primary-pressed);
  --td-brand-color-disabled: #a6bfba;
  --td-radius-default: var(--ui-radius-small);

  min-height: 100%;
  color: var(--ui-color-text-primary);
  background: var(--ui-color-background);
  background-image:
    radial-gradient(circle at 82% 48px, rgba(148, 116, 73, 0.38) 0 1px, transparent 2px),
    radial-gradient(circle at 92% 96px, rgba(36, 93, 89, 0.22) 0 2px, transparent 3px),
    radial-gradient(circle at 74% 148px, rgba(148, 116, 73, 0.26) 0 1px, transparent 2px),
    radial-gradient(
      ellipse at 110% 0%,
      transparent 54%,
      rgba(36, 93, 89, 0.1) 54.3%,
      transparent 54.8%
    ),
    radial-gradient(ellipse at 100% 0%, rgba(171, 205, 192, 0.48), transparent 55%),
    radial-gradient(ellipse at 0% 20%, rgba(239, 224, 197, 0.38), transparent 48%),
    linear-gradient(180deg, #edf3f1 0%, #f7f8f4 65%, #edf3f1 100%);
  background-repeat: no-repeat;
  background-size:
    auto,
    auto,
    auto,
    100% 220px,
    auto,
    auto,
    auto;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 16px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

.page-shell {
  box-sizing: border-box;
  width: 100%;
  max-width: var(--ui-page-max-width);
  min-height: 100vh;
  padding: var(--ui-space-5);
  padding-bottom: calc(var(--ui-space-7) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--ui-space-7) + var(--ui-safe-area-bottom));
  margin: 0 auto;
}

.page-hero {
  padding: var(--ui-space-3) 0 var(--ui-space-7);
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: var(--ui-space-3);
  margin-bottom: var(--ui-space-3);
  color: var(--ui-color-primary);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.12em;
  line-height: 20px;
}

.eyebrow::before {
  width: 24px;
  height: 1px;
  flex: none;
  background: var(--ui-color-accent);
  content: '';
}

.page-title {
  display: block;
  color: var(--ui-color-text-primary);
  font-family: var(--ui-font-display);
  font-size: 30px;
  font-weight: 500;
  letter-spacing: 0.06em;
  line-height: 44px;
  overflow-wrap: break-word;
}

.page-title::after {
  display: block;
  width: 32px;
  height: 2px;
  margin-top: 12px;
  background: var(--ui-color-accent);
  content: '';
  transform: rotate(-4deg);
}

.page-hero {
  animation: ui-ink-reveal 560ms ease-out;
}

@keyframes ui-ink-reveal {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .page-hero {
    animation: none;
  }
}

.page-subtitle {
  display: block;
  max-width: 460px;
  margin-top: var(--ui-space-3);
  color: var(--ui-color-text-secondary);
  font-size: 14px;
  font-weight: 400;
  line-height: 26px;
}

.section-title {
  display: block;
  color: var(--ui-color-text-primary);
  font-size: 20px;
  font-weight: 600;
  line-height: 28px;
}

.supporting-copy {
  display: block;
  color: var(--ui-color-text-secondary);
  font-size: 14px;
  line-height: 24px;
}

.paper-card,
.ui-surface {
  box-sizing: border-box;
  padding: var(--ui-space-5);
  background: var(--ui-color-surface);
  border: 1px solid var(--ui-color-divider);
  border-radius: var(--ui-radius-large);
}

.paper-card + .paper-card {
  margin-top: var(--ui-space-4);
}

.ui-chip {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 28px;
  padding: 4px 10px;
  color: var(--ui-color-primary-strong);
  font-size: 13px;
  font-weight: 500;
  line-height: 18px;
  background: var(--ui-color-primary-soft);
  border-radius: var(--ui-radius-pill);
}

.ui-chip--mood {
  color: #775431;
  background: var(--ui-color-mood-soft);
}

.ui-text-button {
  box-sizing: border-box;
  min-width: 44px;
  min-height: 44px;
  padding: 0 var(--ui-space-2);
  margin: 0;
  color: var(--ui-color-primary);
  font-size: 14px;
  font-weight: 500;
  line-height: 44px;
  background: transparent;
  border: 0;
  border-radius: var(--ui-radius-small);
}

.ui-text-button::after {
  border: 0;
}

.ui-text-button[disabled] {
  color: var(--ui-color-disabled);
  background: transparent;
}

.ui-divider {
  height: 1px;
  background: var(--ui-color-divider);
}

.ui-state {
  display: flex;
  min-height: 280px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: var(--ui-space-7) var(--ui-space-5);
  text-align: center;
}

.ui-state__title {
  display: block;
  margin-top: var(--ui-space-4);
  font-size: 18px;
  font-weight: 600;
  line-height: 28px;
}

.ui-state__copy {
  display: block;
  max-width: 360px;
  margin-top: var(--ui-space-2);
  color: var(--ui-color-text-secondary);
  font-size: 14px;
  line-height: 24px;
}

.component-space {
  margin-top: var(--ui-space-5);
}

.button-stack {
  display: flex;
  flex-direction: column;
  gap: var(--ui-space-3);
  margin-top: var(--ui-space-5);
}

@media (max-width: 340px) {
  .page-shell {
    padding-right: var(--ui-space-4);
    padding-left: var(--ui-space-4);
  }

  .page-title {
    font-size: 26px;
    line-height: 38px;
  }
}
