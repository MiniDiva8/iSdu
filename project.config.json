{
  "description": "iSdu 微信原生 TypeScript 小程序公共工程配置",
  "miniprogramRoot": "miniprogram/",
  "srcMiniprogramRoot": "miniprogram/",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "minifyWXSS": true,
    "minifyWXML": true,
    "nodeModules": true,
    "packNpmManually": true,
    "packNpmRelationList": [
      {
        "packageJsonPath": "./package.json",
        "miniprogramNpmDistDir": "./miniprogram/"
      }
    ],
    "useCompilerPlugins": ["typescript"],
    "skylineRenderEnable": false,
    "uploadWithSourceMap": true,
    "compileWorklet": false,
    "uglifyFileName": false,
    "localPlugins": false,
    "disableUseStrict": false,
    "condition": false,
    "swc": false,
    "disableSWC": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "compileType": "miniprogram",
  "simulatorType": "wechat",
  "appid": "touristappid",
  "projectname": "iSdu",
  "libVersion": "3.7.6",
  "packOptions": {
    "ignore": [
      {
        "value": "assets/README.md",
        "type": "file"
      },
      {
        "value": "components/README.md",
        "type": "file"
      }
    ],
    "include": []
  },
  "condition": {
    "miniprogram": {
      "list": []
    }
  },
  "simulatorPluginLibVersion": {},
  "editorSetting": {}
}
