    "useCompilerPlugins": ["typescript"],
    "skylineRenderEnable": false,
    "uploadWithSourceMap": true,
    "compileWorklet": false,
    "uglifyFileName": false,
    "localPlugins": false,
    "disableUseStrict": false,
    "condition": false,
    "swc": false,
    "disableSWC": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
